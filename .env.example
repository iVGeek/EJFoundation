# Copy to .env for local development, or set these in the Render dashboard.
# Only PUBLIC_* variables reach the browser (baked in at build time).

# Paystack publisher key — pk_test_... for test mode, pk_live_... for live mode.
# On Render: set this in the service Dashboard -> Environment.
PUBLIC_PAYSTACK_KEY=pk_test_0000000000000000000000000000000000000000

# Currency used when a visitor's region isn't one of NGN/GHS/KES/ZAR.
PUBLIC_PAYSTACK_DEFAULT_CURRENCY=KES

# Public site URL (optional; controls canonical/sitemap URLs).
SITE_URL=https://ejhopefoundation.org