---
---
<section id="newsletter" class="section section--alt">
  <div class="container">
    <div class="newsletter reveal">
      <div class="newsletter__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
      </div>
      <h2 class="newsletter__title">Be part of our <em>first season</em></h2>
      <p class="newsletter__text">One short email a month — what we launched, what's next, how a new foundation grows. No spam, ever.</p>
      <form class="newsletter__form" id="newsletter-form" novalidate>
        <label for="newsletter-email" class="sr-only">Email address</label>
        <input type="email" id="newsletter-email" placeholder="you@example.com" class="newsletter__input" required>
        <button type="submit" class="btn btn--primary newsletter__btn">Join the journey</button>
      </form>
      <p class="newsletter__status" id="newsletter-status" aria-live="polite"></p>
    </div>
  </div>
</section>

<style>
  .newsletter{
    max-width:640px;margin:0 auto;text-align:center;
    background:var(--surface);border:1px solid var(--outline-variant);border-radius:var(--radius-md);
    padding:clamp(2.5rem,6vw,3.5rem) clamp(2rem,5vw,2.5rem);
    box-shadow:var(--e2);
  }
  .newsletter__icon{
    width:56px;height:56px;margin:0 auto 1.2rem;border-radius:var(--radius-full);
    background:var(--primary-container);color:var(--primary);
    display:flex;align-items:center;justify-content:center;box-shadow:var(--e1);
  }
  .newsletter__icon svg{width:26px;height:26px;}
  .newsletter__title{font-size:clamp(1.7rem,4vw,2.2rem);}
  .newsletter__title em{font-style:italic;color:var(--primary);}
  .newsletter__text{color:var(--muted);line-height:1.7;margin:.9rem auto 1.6rem;max-width:440px;}
  .newsletter__form{display:flex;gap:.6rem;}
  .newsletter__input{flex:1;background:var(--surface);border:1.5px solid var(--outline);border-radius:var(--radius-xs);padding:.85rem 1.1rem;font-size:.98rem;color:var(--on-surface);transition:border-color .2s;}
  .newsletter__input:focus{outline:none;border-color:var(--primary);}
  .newsletter__status{margin-top:.9rem;font-size:.9rem;color:var(--primary);}
  .newsletter__status.is-error{color:#B3261E;}

  @media(max-width:560px){.newsletter__form{flex-direction:column;}.newsletter__btn{width:100%;justify-content:center;}}
</style>

<script>
  const form=document.getElementById('newsletter-form');
  const status=document.getElementById('newsletter-status');
  form?.addEventListener('submit',e=>{
    e.preventDefault();
    status.classList.remove('is-error');
    status.textContent='thank you — you\'re on the list.';
    form.reset();
  });
</script>