---
const faqs=[
  { q:'Is everything really free?', a:'Yes. All our support services — talks, visits, events, and eventually the helpline — are completely free. We do this because cost should never stop someone from seeking help.' },
  { q:'How do you handle privacy and confidentiality?', a:'When we set up one-to-one support, we follow strict practices borrowed from trained counselors: your details stay private, nothing is shared without your consent, and our home-visit teams are bound by the same care.' },
  { q:'Where do my donations actually go?', a:'Straight into year-one work: getting the 24/7 helpline live, running our first talk sessions and home visits, and covering the small costs of a brand-new foundation. Every program is listed on our site — there\'s nowhere else for it to go.' },
  { q:'How can I get help right now?', a:'If it\'s urgent, never wait: 988 is the national suicide & crisis lifeline through call or text. For anything else, reach us through the contact form or join an upcoming event — we\'ll point you to the right support.' }
];
---
<section id="faq" class="section">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="section-eyebrow reveal">FAQ</span>
      <h2 class="section-title reveal">Questions, <em>answered</em></h2>
      <p class="section-sub reveal">The things people ask us most as we get started.</p>
    </div>

    <div class="faq">
      {faqs.map((f,i)=>(
        <div class="faq__item reveal reveal-d{i===0?1:2}">
          <button class="faq__q" aria-expanded={i===0} aria-controls={`faq-a-${i}`}>
            <span>{f.q}</span>
            <span class="faq__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            </span>
          </button>
          <div class="faq__a" id={`faq-a-${i}`} hidden={i!==0}>
            <p>{f.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq{max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:.8rem;}
  .faq__item{background:var(--surface);border:1px solid var(--outline-variant);border-radius:var(--radius-sm);box-shadow:var(--e1);overflow:hidden;transition:border-color .25s;}
  .faq__item.is-open{border-color:var(--primary);}
  .faq__q{width:100%;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.25rem 1.5rem;background:transparent;border:none;font-weight:600;font-size:1.02rem;color:var(--on-surface);cursor:pointer;text-align:left;}
  .faq__icon{width:28px;height:28px;flex-shrink:0;border-radius:var(--radius-full);background:var(--surface-variant);color:var(--primary);display:flex;align-items:center;justify-content:center;transition:transform .3s var(--ease-out),background .2s;}
  .faq__icon svg{width:15px;height:15px;}
  .faq__item.is-open .faq__icon{background:var(--primary-container);transform:rotate(45deg);}
  .faq__a{padding:0 1.5rem;color:var(--on-surface-variant);line-height:1.75;font-size:.95rem;}
  .faq__a p{padding-bottom:1.4rem;}
</style>

<script>
  const items=document.querySelectorAll('.faq__item');
  items.forEach((item,idx)=>{
    const btn=item.querySelector('.faq__q');
    const ans=item.querySelector('.faq__a');
    btn.addEventListener('click',()=>{
      items.forEach((other,j)=>{
        if(j===idx) return;
        other.classList.remove('is-open');
        other.querySelector('.faq__q').setAttribute('aria-expanded','false');
        other.querySelector('.faq__a').hidden=true;
      });
      const open=item.classList.toggle('is-open');
      btn.setAttribute('aria-expanded',String(open));
      ans.hidden=!open;
    });
  });
</script>