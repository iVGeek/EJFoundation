---
const faqs = [
  {
    q: "How can I get involved with EJ Hope Foundation?",
    a: "There are many ways to get involved! You can volunteer at our events, become a mentor, donate to support our programs, or help spread awareness about mental health in your community."
  },
  {
    q: "Are your services confidential?",
    a: "Yes, all our support services maintain strict confidentiality. We understand the sensitive nature of mental health and ensure that your privacy is protected at all times."
  },
  {
    q: "Do you offer professional counseling?",
    a: "We provide peer support groups and can connect you with licensed mental health professionals in our network. Our programs complement professional treatment and focus on community support."
  },
  {
    q: "How are donations used?",
    a: "Donations directly support our programs including community workshops, support groups, educational materials, and outreach events. We maintain full transparency in our finances."
  },
  {
    q: "Can I share my story with EJ Hope Foundation?",
    a: "Absolutely! We welcome and celebrate stories of recovery and resilience. Your story can inspire others and help break the stigma surrounding mental health."
  }
];
---
<section class="section" aria-labelledby="faq-heading">
  <div class="container container--narrow">
    <h2 id="faq-heading" class="section__title reveal">Frequently Asked Questions</h2>
    <div class="faq__list">
      {faqs.map((faq, i) => (
        <div class={`faq__item reveal reveal-delay-${Math.min(i + 1, 4)}`}>
          <button class="faq__question" aria-expanded="false">
            <span>{faq.q}</span>
            <svg class="faq__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="faq__answer">
            <p>{faq.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__list {
    margin-top: var(--space-xl);
  }

  .faq__item {
    border: 1px solid var(--surface-3);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-md);
    overflow: hidden;
    background: var(--surface-2);
    transition: border-color var(--duration-fast);
  }

  .faq__item.active {
    border-color: rgba(255,127,0,0.3);
  }

  .faq__question {
    width: 100%;
    padding: var(--space-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-1);
    text-align: left;
    transition: color var(--duration-fast);
    font-family: var(--font-body);
  }

  .faq__question:hover {
    color: var(--orange);
  }

  .faq__chevron {
    width: 20px;
    height: 20px;
    color: var(--orange);
    transition: transform var(--duration-normal) var(--ease-out);
    flex-shrink: 0;
  }

  .faq__item.active .faq__chevron {
    transform: rotate(180deg);
  }

  .faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--duration-normal) var(--ease-out),
                padding var(--duration-normal) var(--ease-out);
  }

  .faq__item.active .faq__answer {
    max-height: 300px;
  }

  .faq__answer p {
    padding: 0 var(--space-lg) var(--space-lg);
    color: var(--text-2);
    line-height: 1.8;
    font-size: 0.95rem;
  }
</style>

<script>
  document.querySelectorAll('.faq__question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq__item')!;
      const wasActive = item.classList.contains('active');
      document.querySelectorAll('.faq__item').forEach(i => i.classList.remove('active'));
      document.querySelectorAll('.faq__question').forEach(q => q.setAttribute('aria-expanded', 'false'));
      if (!wasActive) {
        item.classList.add('active');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
