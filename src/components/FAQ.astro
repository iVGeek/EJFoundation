---
const faqs=[
  { q:'How can I get involved?', a:'You can volunteer at our events, become a mentor, donate to support programs, or help spread awareness in your community. Reach out through the contact form and we\'ll match you with the right opportunity.' },
  { q:'Are your services confidential?', a:'Yes — always. We understand how sensitive mental health is. Everything shared with us stays private and protected, full stop.' },
  { q:'Do you offer professional counseling?', a:'We provide peer support groups and connect people with licensed professionals in our network. Our programs complement professional treatment with community care.' },
  { q:'How are donations used?', a:'Donations go directly into our programs: community workshops, support groups, home visits, helpline operations, and educational materials. We publish regular impact updates.' },
  { q:'Can I share my story?', a:'Absolutely — and we\'d be honored. Sharing your story helps others feel less alone and breaks the stigma. Contact us and we\'ll guide you through it.' }
];
---
<section class="section faq">
  <div class="container container__narrow">
    <div class="section-head section-head--center">
      <span class="section-eyebrow reveal">Good to know</span>
      <h2 class="section-title reveal">Frequently asked <em>questions</em></h2>
    </div>

    <div class="faq__list">
      {faqs.map((f,i)=>(
        <div class={`faq__item reveal reveal-d${Math.min(i+1,4)}`}>
          <button class="faq__q" aria-expanded="false">
            <span>{f.q}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="faq__a"><p>{f.a}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .container__narrow{max-width:760px;}
  .faq__list{margin-top:2rem;}
  .faq__item{margin-bottom:1rem;overflow:hidden;background:var(--card);border:1px solid var(--line);border-radius:var(--radius-md);transition:border-color .3s;}
  .faq__q{width:100%;padding:1.4rem 1.5rem;display:flex;justify-content:space-between;align-items:center;font-weight:700;color:var(--ink);font-size:1.02rem;text-align:left;font-family:var(--font-body);}
  .faq__q svg{width:20px;height:20px;color:var(--terra);transition:transform .4s var(--ease-out);flex-shrink:0;}
  .faq__item.is-active{border-color:var(--terra);}
  .faq__item.is-active .faq__q svg{transform:rotate(180deg);}
  .faq__a{max-height:0;overflow:hidden;transition:max-height .45s var(--ease-out);}
  .faq__item.is-active .faq__a{max-height:280px;}
  .faq__a p{padding:0 1.5rem 1.5rem;color:var(--ink-2);line-height:1.8;}
</style>

<script>
  document.querySelectorAll('.faq__q').forEach(q=>{
    q.addEventListener('click',()=>{
      const item=q.closest('.faq__item');
      const open=item.classList.contains('is-active');
      document.querySelectorAll('.faq__item').forEach(x=>{x.classList.remove('is-active');x.querySelector('.faq__q')?.setAttribute('aria-expanded','false');});
      if(!open){item.classList.add('is-active');q.setAttribute('aria-expanded','true');}
    });
  });
</script>
