---
---
<section class="hero" id="top">
  <div class="container hero__content">
    <div class="hero__badge reveal is-visible">✦ Mental Health &amp; Suicide Awareness</div>

    <h1 class="hero__title reveal is-visible">
      In every heart,<br>there is <em>hope.</em>
    </h1>

    <p class="hero__sub reveal is-visible">
      EJ Hope Foundation walks beside you — offering free, confidential support rooted in compassion, community and the memory of Elsie Jelagat.
    </p>

    <div class="hero__cta reveal is-visible">
      <a href="#programs" class="btn btn--primary">Find Support</a>
      <a href="#stories" class="btn btn--outline">Stories of Hope</a>
    </div>
  </div>

  <svg class="hero__wave" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,60 C240,120 480,0 720,40 C960,80 1200,120 1440,60 L1440,120 L0,120 Z" fill="#efe4d3"/>
  </svg>
</section>

<style>
  .hero{
    position:relative;
    padding:clamp(5rem,12vw,8rem) 0 clamp(7rem,14vw,9rem);
    overflow:hidden;
    text-align:center;
    background:
      radial-gradient(50% 60% at 85% 15%, rgba(201,106,60,.16), transparent 60%),
      radial-gradient(40% 50% at 10% 85%, rgba(138,90,59,.12), transparent 60%),
      var(--cream);
  }

  .hero__content{position:relative;z-index:2;}

  .hero__badge{
    display:inline-flex;align-items:center;gap:.5rem;
    font-size:.72rem;font-weight:800;letter-spacing:.22em;text-transform:uppercase;
    color:var(--terra);
    background:#fff;border:1px solid var(--line);
    padding:.55rem 1.1rem;border-radius:var(--radius-full);
    margin-bottom:1.8rem;
  }

  .hero__title{
    font-size:clamp(3rem,9vw,6.2rem);
    line-height:1.02;
    letter-spacing:-.01em;
    font-weight:400;
  }
  .hero__title em{font-style:italic;color:var(--terra);}

  .hero__sub{
    color:var(--muted);
    font-size:clamp(1.05rem,2.2vw,1.28rem);
    max-width:600px;margin:1.6rem auto 0;
    line-height:1.75;
  }

  .hero__cta{display:flex;gap:1rem;justify-content:center;margin-top:2.5rem;flex-wrap:wrap;}

  .hero__wave{
    position:absolute;left:0;right:0;bottom:-1px;width:100%;height:90px;
    z-index:1;pointer-events:none;
  }

  @media(max-width:640px){
    .hero__wave{height:60px;}
  }
</style>
