---
---
<section class="hero" id="top">
  <div class="hero__orb hero__orb--1" aria-hidden="true"></div>
  <div class="hero__orb hero__orb--2" aria-hidden="true"></div>

  <div class="container hero__content">
    <div class="hero__badge reveal is-visible"><span class="hero__badge-dot" aria-hidden="true"></span>Newly founded · In memory of Elsie Jelagat</div>

    <h1 class="hero__title reveal is-visible">
      In every heart,<br>there is <em>hope.</em>
    </h1>

    <p class="hero__sub reveal is-visible">
      EJ Hope Foundation is brand new — built on one promise: no one should face a dark moment alone. Free, confidential support rooted in compassion, community, and the memory of Elsie Jelagat. We're just getting started.
    </p>

    <div class="hero__cta reveal is-visible">
      <a href="#programs" class="btn btn--primary">Find Support</a>
      <a href="#stories" class="btn btn--outline">Stories of Hope</a>
    </div>

    <div class="hero__scroll reveal is-visible">
      <a href="#impact" aria-label="Scroll to impact">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      </a>
    </div>
  </div>

  <svg class="hero__wave" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,64 C240,118 480,22 720,56 C960,90 1200,120 1440,66 L1440,120 L0,120 Z" fill="#efe4d3"/>
  </svg>
</section>

<style>
  .hero{
    position:relative;
    padding:clamp(5rem,12vw,7.5rem) 0 clamp(6.5rem,13vw,8.5rem);
    overflow:hidden;
    text-align:center;
    isolation:isolate;
    background:
      radial-gradient(52% 55% at 84% 12%, rgba(201,106,60,.15), transparent 60%),
      radial-gradient(42% 50% at 12% 88%, rgba(138,90,59,.1), transparent 60%),
      var(--cream);
  }

  .hero__orb{position:absolute;border-radius:50%;pointer-events:none;z-index:0;}
  .hero__orb--1{width:300px;height:300px;top:-90px;left:-90px;background:radial-gradient(circle,rgba(201,106,60,.14),transparent 70%);}
  .hero__orb--2{width:260px;height:260px;bottom:60px;right:-70px;background:radial-gradient(circle,rgba(240,180,138,.18),transparent 70%);}

  .hero__content{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;}

  .hero__badge{
    display:inline-flex;align-items:center;gap:.55rem;
    font-size:.72rem;font-weight:800;letter-spacing:.22em;text-transform:uppercase;
    color:var(--terra);
    background:#fff;border:1px solid var(--line);
    padding:.55rem 1.15rem;border-radius:var(--radius-full);
    margin-bottom:clamp(1.6rem,3.5vw,2.1rem);
    box-shadow:var(--card-shadow);
  }
  .hero__badge-dot{width:8px;height:8px;border-radius:50%;background:var(--terra);animation:pulse-dot 2.2s ease-in-out infinite;}
  @keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.45;transform:scale(.8);}}

  .hero__title{
    font-size:clamp(3rem,9vw,6rem);
    line-height:1.02;
    letter-spacing:-.015em;
    font-weight:400;
  }
  .hero__title em{font-style:italic;color:var(--terra);position:relative;}
  .hero__title em::after{
    content:'';position:absolute;left:0;right:0;bottom:.04em;height:.06em;
    background:var(--grad-brand);border-radius:2px;opacity:.5;
  }

  .hero__sub{
    color:var(--muted);
    font-size:clamp(1.05rem,2.2vw,1.26rem);
    max-width:600px;margin:1.6rem auto 0;
    line-height:1.75;
  }

  .hero__cta{display:flex;gap:1rem;justify-content:center;margin-top:2.5rem;flex-wrap:wrap;}

  .hero__scroll{margin-top:3.5rem;}
  .hero__scroll a{
    display:flex;align-items:center;justify-content:center;
    width:44px;height:44px;border-radius:50%;
    border:1.5px solid var(--line);color:var(--terra);background:#fff;
    transition:transform .3s var(--ease-out),box-shadow .3s,border-color .3s;
    animation:bob 2.4s ease-in-out infinite;
  }
  .hero__scroll svg{width:20px;height:20px;}
  .hero__scroll a:hover{border-color:var(--terra);box-shadow:var(--glow-soft);}
  @keyframes bob{0%,100%{transform:translateY(0);}50%{transform:translateY(6px);}}

  .hero__wave{
    position:absolute;left:0;right:0;bottom:-1px;width:100%;height:clamp(56px,9vw,84px);
    z-index:1;pointer-events:none;
  }

  @media(max-width:640px){
    .hero__scroll{display:none;}
  }
</style>
