---
const stats = [
  { icon: "users", target: 5000, label: "Lives Impacted", suffix: "+" },
  { icon: "calendar", target: 150, label: "Events Hosted", suffix: "+" },
  { icon: "heart", target: 200, label: "Volunteers", suffix: "+" },
  { icon: "building", target: 50, label: "Partner Organizations", suffix: "+" },
];
---
<section class="section stats" aria-labelledby="stats-heading">
  <div class="container">
    <h2 id="stats-heading" class="section__title reveal">Our Impact in Numbers</h2>
    <div class="stats__grid">
      {stats.map((stat, i) => (
        <div class={`stats__card card reveal reveal-delay-${i + 1}`}>
          <div class="stats__icon">
            {stat.icon === "users" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            )}
            {stat.icon === "calendar" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M9 16l2 2 4-4"/></svg>
            )}
            {stat.icon === "heart" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            )}
            {stat.icon === "building" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22V12h6v10M8 6h.01M16 6h.01M12 6h.01M8 10h.01M16 10h.01M12 10h.01"/></svg>
            )}
          </div>
          <div class="stats__number" data-target={stat.target} data-suffix={stat.suffix}>0{stat.suffix}</div>
          <p class="stats__label">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats {
    background: var(--surface-1);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .stats__card {
    text-align: center;
    padding: var(--space-xl) var(--space-lg);
  }

  .stats__icon {
    width: 56px;
    height: 56px;
    margin: 0 auto var(--space-md);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,127,0,0.1);
    border-radius: var(--radius-md);
    color: var(--orange);
    transition: all var(--duration-normal) var(--ease-out);
  }

  .stats__icon svg {
    width: 28px;
    height: 28px;
  }

  .stats__card:hover .stats__icon {
    background: var(--orange);
    color: #fff;
    transform: scale(1.1) rotate(5deg);
    box-shadow: var(--shadow-glow);
  }

  .stats__number {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--space-xs);
  }

  .stats__label {
    color: var(--text-2);
    font-size: 0.95rem;
  }
</style>
