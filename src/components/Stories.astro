---
const stories = [
  { name:'Why we started', role:'Our founding story', text:'We couldn\'t stand by while anyone faced a dark moment alone. So we built this foundation with everything we had — humble in size, unstoppable in purpose.' },
  { name:'What we promise', role:'Our values', text:'Support that is always free, never judged, and completely private. When you come to us, your story stays yours.' },
  { name:'Why it matters', role:'The challenge', text:'Most people who struggle never ask for help. Our job isn\'t to have all the answers — it\'s to make sure help is always there when someone reaches out.' },
  { name:'The road ahead', role:'First year', text:'We\'re honest: everything is still being built, one program at a time. That\'s exactly why your support right now matters so much.' }
];
---
<section id="stories" class="section stories">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="section-eyebrow reveal">Why we do this</span>
      <h2 class="section-title reveal">Our promise, <em>in our own words</em></h2>
    </div>

    <div class="story" id="story-slider">
      <div class="story__track" id="story-track">
        {stories.map((s,i)=>(
          <figure class={`story__slide ${i===0?'is-active':''}`} data-i={i}>
            <p class="story__quote">"{s.text}"</p>
            <figcaption class="story__who">
              <span class="story__avatar">{s.name[0]}</span>
              <span class="story__meta"><span class="story__name">{s.name}</span><span class="story__role">{s.role}</span></span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="story__controls">
        <button class="story__btn" id="story-prev" aria-label="Previous story">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="story__dots" id="story-dots">
          {stories.map((_,i)=>(
            <button class={`story__dot ${i===0?'is-active':''}`} data-i={i} aria-label={`Story ${i+1}`}></button>
          ))}
        </div>
        <button class="story__btn" id="story-next" aria-label="Next story">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .stories{background:var(--surface-variant);}
  .story{max-width:820px;margin:0 auto;position:relative;}
  .story__track{position:relative;min-height:280px;}
  .story__slide{
    position:absolute;inset:0;opacity:0;transform:translateY(16px) scale(.995);
    transition:all .6s var(--ease-out);pointer-events:none;
    background:var(--surface);border:1px solid var(--outline-variant);border-radius:var(--radius-md);
    padding:clamp(2.5rem,6vw,3.5rem) clamp(2rem,5vw,3rem);
    text-align:center;box-shadow:var(--e2);
  }
  .story__slide.is-active{opacity:1;transform:translateY(0) scale(1);position:relative;pointer-events:auto;}
  .story__quote{
    font-size:clamp(1.25rem,3vw,1.65rem);font-weight:500;line-height:1.5;color:var(--on-surface);
    max-width:640px;margin:0 auto 1.8rem;
  }
  .story__who{display:flex;align-items:center;justify-content:center;gap:.9rem;}
  .story__avatar{
    width:46px;height:46px;border-radius:50%;
    background:var(--primary);color:var(--on-primary);
    display:flex;align-items:center;justify-content:center;
    font-weight:600;font-size:1.1rem;
  }
  .story__meta{display:flex;flex-direction:column;text-align:left;}
  .story__name{font-weight:600;color:var(--on-surface);}
  .story__role{color:var(--muted);font-size:.85rem;}

  .story__controls{display:flex;align-items:center;justify-content:center;gap:1.2rem;margin-top:1.8rem;}
  .story__btn{
    width:44px;height:44px;border-radius:var(--radius-full);
    background:var(--surface);border:1px solid var(--outline);color:var(--on-surface-variant);
    display:flex;align-items:center;justify-content:center;
    transition:all .2s var(--ease-out);
  }
  .story__btn:hover{background:var(--primary-container);color:var(--primary);border-color:var(--primary);}
  .story__btn svg{width:20px;height:20px;}
  .story__dots{display:flex;gap:.5rem;}
  .story__dot{width:9px;height:9px;border-radius:50%;background:var(--outline);transition:all .3s var(--ease-out);}
  .story__dot.is-active{background:var(--primary);transform:scale(1.3);}
</style>

<script>
  let idx=0;
  const slides=Array.from(document.querySelectorAll('.story__slide'));
  const dots=Array.from(document.querySelectorAll('.story__dot'));
  function show(n){idx=(n+slides.length)%slides.length;slides.forEach((s,i)=>s.classList.toggle('is-active',i===idx));dots.forEach((d,i)=>d.classList.toggle('is-active',i===idx));}
  document.getElementById('story-prev')?.addEventListener('click',()=>show(idx-1));
  document.getElementById('story-next')?.addEventListener('click',()=>show(idx+1));
  dots.forEach(d=>d.addEventListener('click',()=>show(parseInt(d.dataset.i||'0'))));
  let auto=setInterval(()=>show(idx+1),6000);
  const slider=document.getElementById('story-slider');
  slider?.addEventListener('mouseenter',()=>clearInterval(auto));
  slider?.addEventListener('mouseleave',()=>auto=setInterval(()=>show(idx+1),6000));
</script>