---
const stories = [
  { name:'Sarah M.', role:'Early supporter', text:'The moment I realized I wasn\'t alone, something in me began to heal. In those early days, EJ Hope gave me a safe place to land.' },
  { name:'Michael K.', role:'Founding volunteer', text:'Joining in these first months changed how I see mental health — and how I see myself. Every conversation is a chance to catch someone before they fall.' },
  { name:'Dr. Jane L.', role:'Mental health professional', text:'It\'s rare to see a foundation start this way: humble, honest, and deeply human. We\'re proud to stand with them from day one.' },
  { name:'Daniel O.', role:'Talk attendee', text:'I walked into a university talk expecting nothing. I walked out knowing I could ask for help. That\'s everything.' }
];
---
<section id="stories" class="section stories">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="section-eyebrow reveal">Stories of Hope</span>
      <h2 class="section-title reveal">Real voices, <em>real healing</em></h2>
    </div>

    <div class="story" id="story-slider">
      <div class="story__track" id="story-track">
        {stories.map((s,i)=>(
          <figure class={`story__slide ${i===0?'is-active':''}`} data-i={i}>
            <p class="story__quote">"{s.text}"</p>
            <figcaption class="story__who">
              <span class="story__avatar">{s.name[0]}</span>
              <span class="story__meta"><span class="story__name">{s.name}</span><span class="story__role">{s.role}</span></span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="story__controls">
        <button class="story__btn" id="story-prev" aria-label="Previous story">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="story__dots" id="story-dots">
          {stories.map((_,i)=>(
            <button class={`story__dot ${i===0?'is-active':''}`} data-i={i} aria-label={`Story ${i+1}`}></button>
          ))}
        </div>
        <button class="story__btn" id="story-next" aria-label="Next story">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .stories{background:var(--cream-2);}
  .story{max-width:820px;margin:0 auto;position:relative;}
  .story__track{position:relative;min-height:300px;}
  .story__slide{
    position:absolute;inset:0;opacity:0;transform:translateY(20px) scale(.99);
    transition:all .7s var(--ease-out);pointer-events:none;
    background:#fff;border:1px solid var(--line);border-radius:var(--radius-xl);
    padding:clamp(2.5rem,6vw,4rem) clamp(2rem,5vw,3.5rem);
    text-align:center;box-shadow:var(--card-shadow);
  }
  .story__slide.is-active{opacity:1;transform:translateY(0) scale(1);position:relative;pointer-events:auto;}
  .story__slide::before{
    content:'“';position:absolute;top:-24px;left:50%;transform:translateX(-50%);
    font-family:var(--font-display);font-size:7.5rem;line-height:1;
    color:var(--terra);opacity:.16;
  }
  .story__quote{
    font-family:var(--font-display);font-style:italic;
    font-size:clamp(1.5rem,3.2vw,2.05rem);line-height:1.35;color:var(--ink);
    max-width:680px;margin:0 auto 2rem;
  }
  .story__who{display:flex;align-items:center;justify-content:center;gap:1rem;}
  .story__avatar{
    width:54px;height:54px;border-radius:50%;
    background:var(--grad-brand);color:#fff;
    display:flex;align-items:center;justify-content:center;
    font-family:var(--font-display);font-size:1.4rem;
    box-shadow:var(--glow-soft);
  }
  .story__meta{display:flex;flex-direction:column;text-align:left;}
  .story__name{font-weight:800;color:var(--ink);}
  .story__role{color:var(--muted);font-size:.85rem;}

  .story__controls{display:flex;align-items:center;justify-content:center;gap:1.2rem;margin-top:2rem;}
  .story__btn{
    width:46px;height:46px;border-radius:50%;
    background:#fff;border:1px solid var(--line);color:var(--ink);
    display:flex;align-items:center;justify-content:center;
    transition:all .3s var(--ease-out);
  }
  .story__btn:hover{background:var(--terra);color:#fff;border-color:var(--terra);box-shadow:var(--glow-soft);}
  .story__btn svg{width:20px;height:20px;}
  .story__dots{display:flex;gap:.5rem;}
  .story__dot{width:10px;height:10px;border-radius:50%;background:var(--cream-3);transition:all .3s var(--ease-out);}
  .story__dot.is-active{background:var(--terra);transform:scale(1.25);}
</style>

<script>
  let idx=0;
  const slides=Array.from(document.querySelectorAll('.story__slide'));
  const dots=Array.from(document.querySelectorAll('.story__dot'));
  function show(n){idx=(n+slides.length)%slides.length;slides.forEach((s,i)=>s.classList.toggle('is-active',i===idx));dots.forEach((d,i)=>d.classList.toggle('is-active',i===idx));}
  document.getElementById('story-prev')?.addEventListener('click',()=>show(idx-1));
  document.getElementById('story-next')?.addEventListener('click',()=>show(idx+1));
  dots.forEach(d=>d.addEventListener('click',()=>show(parseInt(d.dataset.i||'0'))));
  let auto=setInterval(()=>show(idx+1),6000);
  const slider=document.getElementById('story-slider');
  slider?.addEventListener('mouseenter',()=>clearInterval(auto));
  slider?.addEventListener('mouseleave',()=>auto=setInterval(()=>show(idx+1),6000));
</script>
