---
---
<div class="crisis-top" id="crisis-top">
  <div class="container crisis-top__inner">
    <span class="crisis-top__tag">Need help now?</span>
    <p class="crisis-top__msg">You are not alone. <span>Free, confidential support.</span></p>
    <div class="crisis-top__cta">
      <a href="tel:988" class="crisis-top__link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Call 988
      </a>
      <a href="sms:988" class="crisis-top__link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Text 988
      </a>
      <a href="#contact" class="crisis-top__link crisis-top__link--chat">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        Chat Now
      </a>
    </div>
  </div>
</div>

<style>
  .crisis-top{
    background:var(--grad-brand);
    color:#fff;
    position:relative;
    z-index:1100;
  }
  .crisis-top__inner{
    display:flex;align-items:center;justify-content:center;
    gap:1.25rem;flex-wrap:wrap;
    padding:.55rem 0;min-height:var(--crisis-h);
  }
  .crisis-top__tag{
    font-weight:800;font-size:.76rem;text-transform:uppercase;letter-spacing:.12em;
    padding:.3rem .7rem;border-radius:var(--radius-full);
    background:rgba(255,255,255,.18);
  }
  .crisis-top__msg{font-weight:700;font-size:.9rem;}
  .crisis-top__msg span{font-weight:600;opacity:.9;}
  .crisis-top__cta{display:flex;gap:.4rem;flex-wrap:wrap;}
  .crisis-top__link{
    display:inline-flex;align-items:center;gap:.4rem;
    padding:.4rem .85rem;border-radius:var(--radius-full);
    background:rgba(255,255,255,.16);font-weight:700;font-size:.82rem;
    transition:background .2s,transform .2s;
  }
  .crisis-top__link svg{width:14px;height:14px;}
  .crisis-top__link:hover{background:rgba(255,255,255,.3);transform:translateY(-1px);}
  .crisis-top__link--chat{
    background:#fff;color:var(--terra-deep);
  }
  .crisis-top__link--chat:hover{background:var(--terra-deep);color:#fff;}

  @media(max-width:768px){
    .crisis-top__msg{display:none;}
  }
</style>
