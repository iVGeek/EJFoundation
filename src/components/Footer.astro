---
const cols=[
  { head:'Explore', links:[['Our Story','#about'],['Programs','#programs'],['Stories','#stories'],['Impact','#impact'],['Events','#events']] },
  { head:'Take Action', links:[['Donate','#donate'],['Get Involved','#get-involved'],['Contact Us','#contact'],['FAQ','#faq'],['Newsletter','#newsletter']] }
];
---
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" class="footer__logo">
        <span class="footer__mark" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none">
            <circle cx="24" cy="24" r="20" stroke="#F57C00" stroke-width="3"/>
            <path d="M16 29c0-5 3-9 8-9s8 4 8 9" stroke="#F57C00" stroke-width="3" stroke-linecap="round"/>
            <circle cx="24" cy="17" r="3.5" fill="#F57C00"/>
          </svg>
        </span>
        <span class="footer__name">EJ.<span class="mark">Hope</span> Foundation</span>
      </a>
      <p class="footer__tag">Born from love, in a new beginning. Free, confidential mental health support — founded in memory of Elsie Jelagat.</p>
    </div>

    {cols.map(c=>(
      <div class="footer__col">
        <h4 class="footer__head">{c.head}</h4>
        <ul class="footer__list">
          {c.links.map(([label,href])=>(
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="footer__bottomline">
    <div class="container">
      <p class="footer__copy">© {new Date().getFullYear()} EJ Hope Foundation.</p>
      <p class="footer__note">If you're in a crisis, call or text <a href="tel:988">988</a> now. You are not alone.</p>
    </div>
  </div>
</footer>

<style>
  .footer{background:var(--surface-variant);border-top:1px solid var(--outline-variant);margin-top:clamp(2rem,4vw,3.5rem);}
  .footer__grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:clamp(2rem,4vw,3rem);padding:clamp(3rem,6vw,4rem) 0 2.5rem;}
  .footer__logo{display:inline-flex;align-items:center;gap:.55rem;margin-bottom:1rem;}
  .footer__mark{width:38px;height:38px;}
  .footer__name{font-size:1.2rem;font-weight:600;}
  .footer__name .mark,.footer__tag{color:var(--primary);}
  .footer__tag{color:var(--muted);font-size:.93rem;line-height:1.7;max-width:330px;margin-top:.4rem;}
  .footer__head{font-size:.8rem;font-weight:600;text-transform:uppercase;letter-spacing:.09em;color:var(--on-surface-variant);margin-bottom:1.1rem;}
  .footer__list{display:flex;flex-direction:column;gap:.65rem;}
  .footer__list a{color:var(--muted);font-size:.93rem;transition:color .2s;}
  .footer__list a:hover{color:var(--primary);}
  .footer__bottomline{border-top:1px solid var(--outline-variant);padding:1.2rem 0;background:var(--surface);}
  .footer__bottomline>.container{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;}
  .footer__copy{color:var(--muted);font-size:.85rem;}
  .footer__note{color:var(--muted);font-size:.85rem;}
  .footer__note a{color:var(--primary);font-weight:600;}

  @media(max-width:860px){.footer__grid{grid-template-columns:1fr 1fr;}.footer__brand{grid-column:1/-1;}}
  @media(max-width:480px){.footer__grid{grid-template-columns:1fr;}}
</style>