---
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" class="footer__logo">
          <svg viewBox="0 0 48 48" fill="none" width="34">
            <circle cx="24" cy="24" r="20" stroke="#c96a3c" stroke-width="2"/>
            <path d="M16 29c0-5 3-9 8-9s8 4 8 9" stroke="#c96a3c" stroke-width="2.4" stroke-linecap="round"/>
            <circle cx="24" cy="17" r="3.5" fill="#c96a3c"/>
          </svg>
          <span>EJ.<span class="mark">Hope</span> Foundation</span>
        </a>
        <p class="footer__tagline">A brand-new foundation, built on a promise: no one should face their darkest moments alone.</p>
        <div class="footer__social">
          <a href="#" aria-label="Facebook" class="footer__social-link"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
          <a href="#" aria-label="Instagram" class="footer__social-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg></a>
          <a href="#" aria-label="Twitter / X" class="footer__social-link"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
          <a href="#" aria-label="LinkedIn" class="footer__social-link"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg></a>
        </div>
      </div>

      <div class="footer__col">
        <h4 class="footer__head">Explore</h4>
        <ul class="footer__links">
          <li><a href="#about">Our Story</a></li>
          <li><a href="#programs">Programs</a></li>
          <li><a href="#stories">Stories of Hope</a></li>
          <li><a href="#impact">Impact</a></li>
          <li><a href="#get-involved">Get Involved</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4 class="footer__head">Find Help</h4>
        <div class="footer__crisis">
          <a href="tel:988" class="footer__crisis-line">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            24/7 Crisis Line <strong>988</strong>
          </a>
          <p class="footer__crisis-sub">Call or text — free & confidential</p>
        </div>
        <a href="#contact" class="footer__link-cta">Contact us →</a>
      </div>

      <div class="footer__col footer__col--news">
        <h4 class="footer__head">Stay connected</h4>
        <p class="footer__news-text">Get one thoughtful update a month. No spam.</p>
        <form class="footer__news" id="footer-news">
          <input type="email" placeholder="Email" required aria-label="Email">
          <button type="submit" class="footer__news-btn" aria-label="Subscribe">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </form>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">© 2025 EJ Hope Foundation. All rights reserved.</p>
      <div class="footer__legal">
        <a href="#privacy">Privacy</a>
        <a href="#terms">Terms</a>
        <a href="#accessibility">Accessibility</a>
      </div>
    </div>
  </div>
  <div class="footer__wordmark" aria-hidden="true">hope</div>
</footer>

<style>
  .footer{background:var(--cream-2);border-top:1px solid var(--line);padding:clamp(3rem,7vw,4.5rem) 0 1.5rem;margin-top:4rem;position:relative;overflow:hidden;}
  .footer__wordmark{
    position:absolute;left:50%;bottom:-.18em;transform:translateX(-50%);
    font-family:var(--font-display);font-style:italic;
    font-size:clamp(8rem,26vw,22rem);line-height:.72;
    color:rgba(201,106,60,.07);pointer-events:none;user-select:none;white-space:nowrap;
    z-index:0;
  }
  .footer .container{position:relative;z-index:1;}
  .footer__grid{display:grid;grid-template-columns:1.5fr 1fr 1.2fr 1.2fr;gap:2.5rem;margin-bottom:3rem;}
  .footer__logo{display:flex;align-items:center;gap:.6rem;font-family:var(--font-display);font-size:1.4rem;margin-bottom:1rem;color:var(--ink);}
  .footer__logo .mark{color:var(--terra);}
  .footer__tagline{color:var(--ink-2);font-size:.92rem;line-height:1.7;max-width:300px;margin-bottom:1.3rem;}
  .footer__social{display:flex;gap:.6rem;}
  .footer__social-link{width:40px;height:40px;border-radius:50%;background:#fff;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--ink-2);transition:all .3s var(--ease-out);}
  .footer__social-link svg{width:17px;height:17px;}
  .footer__social-link:hover{background:var(--terra);color:#fff;border-color:var(--terra);transform:translateY(-3px);box-shadow:var(--glow-soft);}
  .footer__head{font-size:.72rem;text-transform:uppercase;letter-spacing:.2em;color:var(--terra);margin-bottom:1.1rem;font-weight:800;font-family:var(--font-body);}
  .footer__links li{margin-bottom:.6rem;}
  .footer__links a{color:var(--ink-2);font-size:.92rem;transition:color .2s,padding-left .2s;}
  .footer__links a:hover{color:var(--terra);padding-left:4px;}
  .footer__crisis-line{display:flex;align-items:center;gap:.5rem;color:var(--ink);font-weight:600;font-size:.95rem;margin-bottom:.4rem;}
  .footer__crisis-line svg{width:17px;height:17px;color:var(--terra);}
  .footer__crisis-line strong{color:var(--terra);}
  .footer__crisis-sub{color:var(--muted);font-size:.82rem;margin-bottom:1rem;}
  .footer__link-cta{color:var(--terra);font-weight:800;font-size:.92rem;}
  .footer__link-cta:hover{text-decoration:underline;}
  .footer__news-text{color:var(--muted);font-size:.88rem;margin-bottom:.8rem;}
  .footer__news{display:flex;gap:.4rem;}
  .footer__news input{flex:1;padding:.7rem .9rem;border-radius:var(--radius-md);border:1.5px solid var(--line);background:#fff;color:var(--ink);font-family:var(--font-body);}
  .footer__news input:focus{outline:none;border-color:var(--terra);}
  .footer__news-btn{width:44px;height:44px;border-radius:var(--radius-md);background:var(--terra);display:flex;align-items:center;justify-content:center;color:#fff;transition:transform .2s;}
  .footer__news-btn:hover{background:var(--terra-deep);}
  .footer__news-btn svg{width:18px;height:18px;}
  .footer__news-btn:hover{transform:translateX(3px);}
  .footer__bottom{border-top:1px solid var(--line);padding-top:1.5rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;}
  .footer__copyright{font-size:.82rem;color:var(--muted);}
  .footer__legal{display:flex;gap:1.5rem;}
  .footer__legal a{font-size:.82rem;color:var(--muted);transition:color .2s;}
  .footer__legal a:hover{color:var(--terra);}

  @media(max-width:900px){.footer__grid{grid-template-columns:1fr 1fr;}}
  @media(max-width:560px){.footer__grid{grid-template-columns:1fr;}.footer__bottom{flex-direction:column;text-align:center;}}
</style>

<script>
  document.getElementById('footer-news')?.addEventListener('submit',e=>{e.preventDefault();const i=e.target.querySelector('input');if(i?.value){alert('Subscribed! Watch for our next update.');i.value='';}});
</script>
