---
---
<section id="contact" class="section">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="section-eyebrow reveal">Contact</span>
      <h2 class="section-title reveal">Say <em>hello</em></h2>
      <p class="section-sub reveal">Questions, ideas, or a story to share — drop us a line. We answer every message.</p>
    </div>

    <div class="contact reveal">
      <a href="tel:+15555550101" class="contact__row">
        <span class="contact__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </span>
        <span class="contact__row-body">
          <span class="contact__label">Call us</span>
          <span class="contact__value">+1 (555) 501-0101</span>
        </span>
        <span class="contact__arw" aria-hidden="true">→</span>
      </a>
      <a href="mailto:hello@ejhopefoundation.org" class="contact__row">
        <span class="contact__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
        </span>
        <span class="contact__row-body">
          <span class="contact__label">Email us</span>
          <span class="contact__value">hello@ejhopefoundation.org</span>
        </span>
        <span class="contact__arw" aria-hidden="true">→</span>
      </a>
      <a href="#" class="contact__row">
        <span class="contact__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
        <span class="contact__row-body">
          <span class="contact__label">Community</span>
          <span class="contact__value">Our community spaces (coming soon)</span>
        </span>
        <span class="contact__arw" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact{max-width:620px;margin:0 auto;display:flex;flex-direction:column;gap:.9rem;}
  .contact__row{
    display:flex;align-items:center;gap:1rem;
    background:var(--surface);border:1px solid var(--outline-variant);
    border-radius:var(--radius-sm);padding:1.1rem 1.4rem;
    box-shadow:var(--e1);
    transition:box-shadow .25s var(--ease-out),transform .25s var(--ease-out),border-color .25s;
  }
  .contact__row:hover{box-shadow:var(--e2);border-color:var(--outline);transform:translateX(4px);}
  .contact__icon{
    width:44px;height:44px;flex-shrink:0;border-radius:var(--radius-full);
    background:var(--primary-container);color:var(--primary);
    display:flex;align-items:center;justify-content:center;
  }
  .contact__icon svg{width:20px;height:20px;}
  .contact__row-body{display:flex;flex-direction:column;flex:1;}
  .contact__label{font-size:.76rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);}
  .contact__value{font-weight:500;color:var(--on-surface);font-size:1rem;}
  .contact__arw{color:var(--primary);font-size:1.2rem;}
</style>