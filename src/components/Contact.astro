---
---
<section id="contact" class="section">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="section-eyebrow reveal">Contact</span>
      <h2 class="section-title reveal">We'd love to <em>hear from you</em></h2>
      <p class="section-sub reveal">Questions, partnership ideas, or support requests — reach out any time.</p>
    </div>

    <div class="contact__grid">
      <div class="contact__info reveal">
        <div class="contact__crisis-card">
          <div class="contact__crisis-kick">In crisis? Talk to a human now.</div>
          <p class="contact__crisis-text">If you or someone you know is in immediate danger, please reach out right away.</p>
          <div class="contact__crisis-btns">
            <a href="tel:988" class="contact__crisis-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Call <strong>988</strong>
            </a>
            <a href="sms:988" class="contact__crisis-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              Text <strong>988</strong>
            </a>
          </div>
        </div>

        <div class="contact__methods">
          <div class="contact__method">
            <span class="contact__method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
            </span>
            <div>
              <p class="contact__method-label">Email us</p>
              <a href="mailto:contact@ejhope.org" class="contact__method-val">contact@ejhope.org</a>
            </div>
          </div>
          <div class="contact__method">
            <span class="contact__method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <div>
              <p class="contact__method-label">Call us</p>
              <a href="tel:+1234567890" class="contact__method-val">+123 456 7890</a>
            </div>
          </div>
          <div class="contact__method">
            <span class="contact__method-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <div>
              <p class="contact__method-label">Visit us</p>
              <span class="contact__method-val">123 Hope Street, City</span>
            </div>
          </div>
        </div>
      </div>

      <form class="contact__form reveal reveal-d2" id="contact-form">
        <div class="contact__row">
          <div class="contact__field">
            <label for="c-name" class="contact__label">Name</label>
            <input type="text" id="c-name" placeholder="Your name" required class="contact__input">
          </div>
          <div class="contact__field">
            <label for="c-email" class="contact__label">Email</label>
            <input type="email" id="c-email" placeholder="you@example.com" required class="contact__input">
          </div>
        </div>
        <div class="contact__field">
          <label for="c-subject" class="contact__label">I'm reaching out about</label>
          <select id="c-subject" required class="contact__input">
            <option value="">Select a topic</option>
            <option>Volunteer opportunity</option>
            <option>Partnership</option>
            <option>Donation inquiry</option>
            <option>Seeking support</option>
            <option>Share my story</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="contact__field">
          <label for="c-msg" class="contact__label">Message</label>
          <textarea id="c-msg" placeholder="How can we help?" required class="contact__input contact__textarea"></textarea>
        </div>
        <button type="submit" class="btn btn--primary contact__submit">
          Send Message
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact__grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:2.5rem;align-items:start;}
  .contact__crisis-card{padding:2rem;margin-bottom:1.5rem;background:var(--grad-deep);color:var(--on-dark);border-radius:var(--radius-lg);box-shadow:var(--card-shadow-lg);}
  .contact__crisis-kick{font-family:var(--font-display);font-size:1.4rem;color:var(--on-dark);margin-bottom:.5rem;}
  .contact__crisis-text{color:rgba(250,244,234,.8);font-size:.95rem;line-height:1.7;margin-bottom:1.3rem;}
  .contact__crisis-btns{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;}
  .contact__crisis-btn{display:flex;align-items:center;justify-content:center;gap:.5rem;padding:.9rem;border-radius:var(--radius-md);background:var(--terra);color:#fff;font-weight:700;font-size:.95rem;transition:transform .3s var(--ease-spring),background .3s;}
  .contact__crisis-btn:hover{transform:translateY(-3px);background:var(--terra-deep);}
  .contact__crisis-btn svg{width:18px;height:18px;}
  .contact__crisis-btn strong{margin-left:.2rem;}

  .contact__methods{display:flex;flex-direction:column;gap:1.1rem;}
  .contact__method{display:flex;gap:1rem;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:var(--radius-md);padding:1rem 1.2rem;}
  .contact__method-icon{width:46px;height:46px;border-radius:var(--radius-md);flex-shrink:0;background:rgba(201,106,60,.1);display:flex;align-items:center;justify-content:center;color:var(--terra);}
  .contact__method-icon svg{width:21px;height:21px;}
  .contact__method-label{font-size:.76rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;font-weight:700;}
  .contact__method-val{font-size:1rem;font-weight:700;color:var(--ink);}
  .contact__method a:hover{color:var(--terra);}

  .contact__form{padding:2.2rem;background:var(--card);border:1px solid var(--line);border-radius:var(--radius-lg);box-shadow:var(--card-shadow);}
  .contact__row{display:grid;grid-template-columns:1fr 1fr;gap:1rem;}
  .contact__field{margin-bottom:1.2rem;}
  .contact__label{display:block;font-size:.82rem;font-weight:700;color:var(--ink-2);margin-bottom:.45rem;}
  .contact__input{width:100%;padding:.9rem 1rem;background:var(--cream);border:1.5px solid var(--line);border-radius:var(--radius-md);color:var(--ink);font-size:.95rem;font-family:var(--font-body);transition:border-color .25s;background:#fff;}
  .contact__input:focus{outline:none;border-color:var(--terra);}
  .contact__input::placeholder{color:var(--muted);}
  .contact__textarea{min-height:130px;resize:vertical;}
  .contact__submit{width:100%;justify-content:center;padding:1rem;font-size:1.02rem;}

  @media(max-width:900px){.contact__grid{grid-template-columns:1fr;}.contact__row{grid-template-columns:1fr;}}
</style>

<script>
  document.getElementById('contact-form')?.addEventListener('submit',e=>{
    e.preventDefault();
    const f=e.target;
    const name=f.querySelector('#c-name').value.trim();
    const email=f.querySelector('#c-email').value.trim();
    const msg=f.querySelector('#c-msg').value.trim();
    if(name&&email&&msg){
      alert('Thank you — your message is with us. We\'ll get back to you soon.');
      f.reset();
    }else alert('Please fill in all required fields.');
  });
</script>
