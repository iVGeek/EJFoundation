---
const ways=[
  { title:'Be a Founding Volunteer', desc:'Join the handful of people shaping this foundation from day one — events, home visits, and workshops.', cta:'Volunteer with us' },
  { title:'Become a Founding Partner', desc:'Stand with us before anyone has heard of us. Your support carries our first year and beyond.', cta:'Partner with us' },
  { title:'Spread Awareness', desc:'Tell your circle who we are. A new foundation grows one conversation at a time.', cta:'Share the mission' }
];

const tiers=[
  { name:'Founder', color:'var(--primary)', feats:['Name on our founding wall','First-year impact updates','Early access to everything'] },
  { name:'Patron', color:'var(--primary)', featured:true, feats:['Everything in Founder','Named in launch materials','Invitation to our launch event'] },
  { name:'Champion', color:'var(--primary)', feats:['Everything in Patron','Co-naming a year-one program','A seat at our first table'] }
];
---
<section id="get-involved" class="section section--alt">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="section-eyebrow reveal">Get Involved</span>
      <h2 class="section-title reveal">Help us <em>get started</em></h2>
      <p class="section-sub reveal">We're new, we're small, and everything is still being built. There has never been an easier time to make your mark.</p>
    </div>

    <div class="involved__ways">
      {ways.map((w,i)=>(
        <div class={`involved__way reveal reveal-d${(i%3)+1}`}>
          <div class="involved__icon">{['01','02','03'][i]}</div>
          <h3 class="involved__title">{w.title}</h3>
          <p class="involved__desc">{w.desc}</p>
          <a href="#contact" class="involved__link">{w.cta} <span aria-hidden="true">→</span></a>
        </div>
      ))}
    </div>

    <div class="involved__sponsor">
      <div class="section-head section-head--center" style="margin-top:4rem;">
        <span class="section-eyebrow reveal">Founding sponsorship</span>
        <h2 class="section-title reveal">Be among our <em>first partners</em></h2>
        <p class="section-sub reveal">We're brand new. Your brand can be part of the story from the very beginning — visibility now, real impact forever.</p>
      </div>

      <div class="involved__tiers">
        {tiers.map((t,i)=>(
          <div class={`involved__tier reveal reveal-d${(i%3)+1} ${t.featured?'is-featured':''}`}>
            {t.featured && <span class="involved__pop">Most chosen</span>}
            <div class="involved__medal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
            </div>
            <h3 class="involved__tier-name">{t.name}</h3>
            <ul class="involved__feats">
              {t.feats.map(f=>(
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg>{f}</li>
              ))}
            </ul>
            <a href="#donate" class={`btn ${t.featured?'btn--primary':'btn--outline'} involved__tier-btn`}>Give {t.name}</a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .involved__ways{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;}
  .involved__way{padding:2rem 1.8rem;text-align:center;background:var(--surface);border:1px solid var(--outline-variant);border-radius:var(--radius-sm);box-shadow:var(--e1);transition:box-shadow .3s var(--ease-out),transform .3s var(--ease-out),border-color .3s;}
  .involved__way:hover{transform:translateY(-3px);box-shadow:var(--e2);border-color:var(--outline);}
  .involved__icon{
    width:52px;height:52px;margin:0 auto 1rem;border-radius:var(--radius-full);
    background:var(--primary-container);color:var(--primary);
    display:flex;align-items:center;justify-content:center;
    font-weight:700;font-size:1.05rem;
  }
  .involved__title{font-size:1.2rem;margin-bottom:.45rem;}
  .involved__desc{color:var(--muted);font-size:.9rem;line-height:1.7;margin-bottom:1rem;}
  .involved__link{color:var(--primary);font-weight:600;font-size:.92rem;}

  .involved__tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;align-items:start;}
  .involved__tier{padding:2.1rem 1.9rem;text-align:center;position:relative;background:var(--surface);border:1px solid var(--outline-variant);border-radius:var(--radius-md);box-shadow:var(--e1);display:flex;flex-direction:column;}
  .involved__tier.is-featured{border:2px solid var(--primary);box-shadow:var(--e2);}
  .involved__tier:not(.is-featured):hover{box-shadow:var(--e2);transform:translateY(-3px);}
  .involved__pop{position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--primary);color:var(--on-primary);font-size:.68rem;font-weight:600;padding:.3rem .8rem;border-radius:var(--radius-xs);white-space:nowrap;box-shadow:var(--e1);}
  .involved__medal svg{width:38px;height:38px;margin:0 auto .8rem;color:var(--primary);}
  .involved__tier-name{font-size:1.25rem;}
  .involved__tier-amt{font-size:2rem;font-weight:700;margin:.25rem 0 1.2rem;color:var(--primary);letter-spacing:-.02em;}
  .involved__feats{text-align:left;margin-bottom:1.6rem;flex:1;}
  .involved__feats li{display:flex;align-items:center;gap:.6rem;padding:.6rem 0;color:var(--on-surface-variant);font-size:.88rem;border-bottom:1px solid var(--outline-variant);}
  .involved__feats li:last-child{border-bottom:none;}
  .involved__feats svg{width:16px;height:16px;color:var(--primary);flex-shrink:0;}
  .involved__tier-btn{width:100%;justify-content:center;}

  @media(max-width:900px){.involved__ways,.involved__tiers{grid-template-columns:1fr;}.involved__tier.is-featured{transform:none;}.involved__tier.is-featured:hover{transform:translateY(-3px);}}
</style>