---
---
<section id="about" class="section">
  <div class="container about__grid">
    <!-- Art panel -->
    <div class="about__media reveal">
      <div class="about__media-inner">
        <div class="ring ring--1" aria-hidden="true"></div>
        <div class="ring ring--2" aria-hidden="true"></div>
        <div class="orb orbs--1" aria-hidden="true"></div>
        <div class="orb orbs--2" aria-hidden="true"></div>
        <span class="about__heart" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        </span>
        <p class="about__quote">"We refuse to let anyone face their darkest moments alone."</p>
      </div>
    </div>

    <!-- Story -->
    <div class="about__text reveal reveal-d2">
      <span class="section-eyebrow">Our Story</span>
      <h2 class="section-title">Born from love, <br>carried by <em>community</em></h2>
      <p class="about__p">
        EJ Hope Foundation was created in memory of <strong class="accent">Elsie Jelagat</strong> — a bright soul whose life reminded everyone who knew her just how deeply mental health touches us all.
      </p>
      <blockquote class="about__block">"We walk beside people through life's hardest moments."</blockquote>
      <p class="about__p">
        What began as a promise to honor her has grown into a movement — one where no one faces their darkest moments alone, and where support is always free and never judged.
      </p>

      <div class="paths">
        <a class="path" href="#programs">
          <div>
            <h4>I need support</h4>
            <span class="path__hint">For yourself or someone you love</span>
          </div>
          <span class="path__arw">→</span>
        </a>
        <a class="path" href="#get-involved">
          <div>
            <h4>I want to help</h4>
            <span class="path__hint">Volunteer, support, give back</span>
          </div>
          <span class="path__arw">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid{display:grid;grid-template-columns:1fr 1.05fr;gap:clamp(2.5rem,5vw,4rem);align-items:center;}

  .about__media-inner{
    position:relative;border-radius:var(--radius-xl);overflow:hidden;
    height:clamp(360px,46vw,480px);
    background:linear-gradient(160deg,var(--terracotta),var(--clay));
    box-shadow:var(--card-shadow-lg);
  }
  .about__quote{
    position:absolute;left:2rem;right:2rem;bottom:2rem;
    color:#fff;font-family:var(--font-display);font-style:italic;
    font-size:clamp(1.2rem,2.4vw,1.5rem);line-height:1.3;z-index:2;
  }
  .ring{position:absolute;border:2px solid rgba(255,255,255,.28);border-radius:50%;}
  .ring--1{width:120px;height:120px;top:2.5rem;left:2.5rem;}
  .ring--1::after{content:'';position:absolute;inset:18px;border:2px solid rgba(255,255,255,.22);border-radius:50%;}
  .ring--2{width:70px;height:70px;top:5rem;left:5.5rem;border:2px solid rgba(255,255,255,.35);border-radius:50%;}
  .orbs--1{position:absolute;bottom:-60px;right:-40px;width:300px;height:300px;background:rgba(61,46,36,.4);border-radius:50%;}
  .orbs--2{position:absolute;top:3rem;right:2.5rem;width:52px;height:52px;background:rgba(240,180,138,.5);border-radius:50%;}
  .about__heart{
    position:absolute;bottom:2rem;right:2rem;width:64px;height:64px;
    border-radius:50%;background:rgba(255,255,255,.14);
    display:flex;align-items:center;justify-content:center;color:#fde8d6;
    backdrop-filter:blur(4px);
    z-index:2;animation:heartbeat 2.6s ease-in-out infinite;
  }
  .about__heart svg{width:30px;height:30px;}
  @keyframes heartbeat{0%,20%,50%,80%,100%{transform:scale(1);}40%{transform:scale(1.12);}60%{transform:scale(1.06);}}

  .about__p{color:var(--ink-2);font-size:1.05rem;line-height:1.85;margin-top:1.1rem;max-width:540px;}
  .about__block{
    border-left:4px solid var(--terra);padding-left:1.4rem;
    font-family:var(--font-display);font-style:italic;
    font-size:1.5rem;line-height:1.3;color:var(--brown);
    margin:1.8rem 0;
  }

  .paths{display:flex;flex-direction:column;gap:.9rem;margin-top:1.6rem;}
  .path{
    display:flex;align-items:center;justify-content:space-between;
    padding:1.35rem 1.55rem;
    background:var(--card);border:1px solid var(--line);
    border-radius:var(--radius-md);
    transition:transform .25s var(--ease-out),border-color .25s,box-shadow .25s;
  }
  .path:hover{border-color:var(--terra);transform:translateX(8px);box-shadow:var(--card-shadow);}
  .path h4{font-family:var(--font-display);font-size:1.4rem;font-weight:400;color:var(--ink);}
  .path__hint{color:var(--muted);font-size:.88rem;}
  .path__arw{color:var(--terra);font-size:1.6rem;font-weight:400;}

  @media(max-width:900px){.about__grid{grid-template-columns:1fr;gap:2.5rem;}}
</style>
