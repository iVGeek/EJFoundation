---
const promise = [
  'No one faces a dark moment alone',
  'Support is always free — never judged',
  'Privacy and confidentiality, full stop',
  'Built with our community, from day one'
];
---
<section id="about" class="section">
  <div class="container about__grid">
    <div class="about__text reveal">
      <span class="section-eyebrow">Who We Are</span>
      <h2 class="section-title">Born from love, <br>in a <em>new beginning</em></h2>
      <p class="about__p">
        EJ Hope Foundation was founded in memory of <strong class="accent">Elsie Jelagat</strong> — a bright soul whose life reminded everyone who knew her just how deeply mental health touches us all.
      </p>
      <p class="about__p">
        We are brand new. Everything we are today was built in months, by a handful of people who refused to wait for someone else to act. What began as a promise to honor Elsie is now a foundation taking its first, careful steps — humble in size, ambitious in purpose, built with the community from day one.
      </p>

      <div class="paths">
        <a class="path" href="#programs">
          <div>
            <h4>I need support</h4>
            <span class="path__hint">For yourself or someone you love</span>
          </div>
          <span class="path__arw" aria-hidden="true">→</span>
        </a>
        <a class="path" href="#get-involved">
          <div>
            <h4>I want to help</h4>
            <span class="path__hint">Volunteer, support, give back</span>
          </div>
          <span class="path__arw" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="about__promise reveal reveal-d2" aria-hidden="true">
      <h3 class="about__promise-title">Our promise</h3>
      <ul class="about__promise-list">
        {promise.map(p=>(
          <li class="about__promise-item">
            <span class="about__promise-check">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            {p}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about__grid{display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(2.5rem,5vw,4rem);align-items:center;}

  .about__p{color:var(--on-surface-variant);font-size:1.03rem;line-height:1.8;margin-top:1.1rem;max-width:540px;}

  .about__promise{
    background:var(--surface);border:1px solid var(--outline-variant);
    border-radius:var(--radius-md);padding:2.2rem 2rem;
    box-shadow:var(--e2);
  }
  .about__promise-title{font-size:1.35rem;font-weight:600;margin-bottom:1.4rem;}
  .about__promise-list{display:flex;flex-direction:column;gap:1rem;}
  .about__promise-item{display:flex;align-items:center;gap:.8rem;color:var(--on-surface-variant);font-size:1rem;line-height:1.5;}
  .about__promise-check{
    width:26px;height:26px;border-radius:50%;flex-shrink:0;
    background:var(--primary-container);color:var(--primary);
    display:flex;align-items:center;justify-content:center;
  }
  .about__promise-check svg{width:14px;height:14px;}

  .paths{display:flex;flex-direction:column;gap:.8rem;margin-top:1.8rem;}
  .path{
    display:flex;align-items:center;justify-content:space-between;
    padding:1.1rem 1.4rem;
    background:var(--surface);border:1px solid var(--outline-variant);
    border-radius:var(--radius-sm);
    box-shadow:var(--e1);
    transition:box-shadow .25s var(--ease-out),transform .25s var(--ease-out),border-color .25s;
  }
  .path:hover{box-shadow:var(--e2);border-color:var(--outline);transform:translateX(4px);}
  .path h4{font-size:1.1rem;font-weight:600;color:var(--on-surface);}
  .path__hint{color:var(--muted);font-size:.85rem;}
  .path__arw{color:var(--primary);font-size:1.3rem;}

  @media(max-width:900px){.about__grid{grid-template-columns:1fr;gap:2.5rem;}}
</style>