---
const stats = [
  { value: 1000, suffix: '+', label: 'People reached' },
  { value: 20, suffix: '+', label: 'Support conversations' },
  { value: 50, suffix: '+', label: 'Founding volunteers' },
  { value: 5, suffix: '+', label: 'Programs launching' }
];
---
<section id="impact" class="impact">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="section-eyebrow reveal">Year One</span>
      <h2 class="section-title reveal">New foundation, <em>big promise</em></h2>
      <p class="section-sub reveal">We're just getting started — and we're honest about it. These are the goals we're building toward in our first year, and we can't reach them without you.</p>
    </div>

    <div class="impact__grid">
      {stats.map((s,i)=>(
        <div class={`impact__item reveal reveal-d${(i%4)+1}`}>
          <div class="impact__num">
            {s.prefix && <span class="impact__num-prefix">{s.prefix}</span>}
            <span data-target={s.value} data-suffix={s.suffix}>0{s.suffix}</span>
          </div>
          <div class="impact__label">{s.label}</div>
        </div>
      ))}
    </div>

    <p class="impact__note reveal">Year one goals · Built together, with you</p>
  </div>
</section>

<style>
  .impact{padding:clamp(3.5rem,8vw,6rem) 0;}

  .impact__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.1rem;}
  .impact__item{
    background:var(--surface);border:1px solid var(--outline-variant);
    border-radius:var(--radius-sm);padding:1.7rem 1.4rem;text-align:center;
    box-shadow:var(--e1);
    transition:box-shadow var(--dur-mid),transform var(--dur-mid);
  }
  .impact__item:hover{box-shadow:var(--e2);transform:translateY(-3px);}

  .impact__num{font-size:clamp(2rem,4vw,2.6rem);font-weight:600;letter-spacing:-.02em;color:var(--primary);line-height:1;}
  .impact__num-prefix{font-size:.6em;margin-right:1px;color:var(--primary-hover);}
  .impact__label{font-size:.9rem;color:var(--muted);margin-top:.6rem;}

  .impact__note{text-align:center;color:var(--muted);font-size:.95rem;margin-top:1.6rem;}

  @media(max-width:900px){.impact__grid{grid-template-columns:1fr 1fr;gap:1rem;}}
</style>