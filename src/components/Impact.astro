---
const stats = [
  { value: 5000, suffix: '+', label: 'Lives touched' },
  { value: 320, suffix: '+', label: 'Workshops' },
  { value: 200, suffix: '+', label: 'Volunteers' },
  { value: 50, suffix: '+', label: 'Partners' }
];
---
<section id="impact" class="impact">
  <div class="container impact__head">
    <span class="section-eyebrow reveal">Our Impact</span>
    <h2 class="section-title reveal">Change, measured in <em>lives touched</em></h2>
    <p class="section-sub reveal">Numbers matter, but stories matter more. Behind every statistic is a person who found support.</p>
  </div>

  <div class="trust">
    <div class="container trust__grid">
      {stats.map((s,i)=>(
        <div class={`trust__item reveal reveal-d${(i%4)+1}`}>
          <div class="trust__num" data-target={s.value} data-suffix={s.suffix}>0{s.suffix}</div>
          <div class="trust__label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .impact{padding:clamp(3.5rem,8vw,6rem) 0 0;}
  .impact__head{text-align:center;margin-bottom:2.5rem;}
  .impact__head .section-eyebrow{margin-inline:auto;}

  .trust{background:var(--grad-deep);margin-top:clamp(2rem,5vw,3rem);position:relative;padding:clamp(2.5rem,6vw,4rem) 0;overflow:hidden;}
  .trust::before{content:'';position:absolute;right:-120px;top:-120px;width:340px;height:340px;background:radial-gradient(circle,rgba(201,106,60,.4),transparent 70%);border-radius:50%;}
  .trust::after{content:'';position:absolute;left:-80px;bottom:-140px;width:300px;height:300px;background:radial-gradient(circle,rgba(240,180,138,.15),transparent 70%);border-radius:50%;}

  .trust__grid{position:relative;z-index:2;display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;text-align:center;}
  .trust__num{font-family:var(--font-display);font-size:clamp(2.6rem,5vw,3.6rem);line-height:1;color:var(--on-dark);}
  .trust__num::after{content:'';display:block;width:34px;height:3px;background:var(--terra);border-radius:2px;margin:.9rem auto 0;}
  .trust__label{font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;color:rgba(250,244,234,.7);margin-top:.7rem;font-weight:600;}

  @media(max-width:800px){.trust__grid{grid-template-columns:1fr 1fr;gap:2.5rem 1rem;}}
</style>
