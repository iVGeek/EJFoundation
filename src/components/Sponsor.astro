---
const tiers = [
  {
    name: "Bronze",
    amount: "$1,000+",
    color: "#cd7f32",
    featured: false,
    benefits: ["Logo on website", "Event recognition", "Quarterly updates"]
  },
  {
    name: "Silver",
    amount: "$5,000+",
    color: "#c0c0c0",
    featured: true,
    benefits: ["All Bronze benefits", "Social media shoutouts", "Program naming opportunity"]
  },
  {
    name: "Gold",
    amount: "$10,000+",
    color: "#ffd700",
    featured: false,
    benefits: ["All Silver benefits", "Board meeting invitations", "Custom partnership package"]
  }
];
---
<section id="sponsor" class="section section--alt" aria-labelledby="sponsor-heading">
  <div class="container">
    <div class="section__header">
      <h2 id="sponsor-heading" class="section__title reveal">Become a Sponsor</h2>
      <p class="section__subtitle reveal reveal-delay-1">Your support transforms lives. Sponsor our programs and events to help us raise awareness and break the stigma surrounding mental health.</p>
    </div>

    <div class="sponsor__tiers">
      {tiers.map((t, i) => (
        <div class={`sponsor__card card reveal reveal-delay-${i + 1} ${t.featured ? 'sponsor__card--featured' : ''}`}>
          <div class="sponsor__medal" style={`color: ${t.color};`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
          </div>
          <h3 class="sponsor__name">{t.name} Sponsor</h3>
          <p class="sponsor__amount" style={`color: ${t.color};`}>{t.amount}</p>
          <ul class="sponsor__benefits">
            {t.benefits.map(b => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg>
                {b}
              </li>
            ))}
          </ul>
          <a href="#contact" class={`btn ${t.featured ? 'btn--primary' : 'btn--ghost'}`}>Select {t.name}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .sponsor__tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    align-items: start;
  }

  .sponsor__card {
    text-align: center;
    padding: var(--space-xl);
    position: relative;
  }

  .sponsor__card--featured {
    border-color: var(--orange);
    background: linear-gradient(135deg, rgba(255,127,0,0.05), rgba(255,69,0,0.05));
    transform: scale(1.05);
  }

  .sponsor__card--featured:hover {
    transform: scale(1.08);
  }

  .sponsor__medal {
    margin-bottom: var(--space-md);
  }

  .sponsor__medal svg {
    width: 48px;
    height: 48px;
    margin-inline: auto;
  }

  .sponsor__name {
    font-size: 1.3rem;
    margin-bottom: var(--space-sm);
  }

  .sponsor__amount {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: var(--space-lg);
  }

  .sponsor__benefits {
    text-align: left;
    margin-bottom: var(--space-xl);
  }

  .sponsor__benefits li {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.625rem 0;
    font-size: 0.95rem;
    color: var(--text-2);
    border-bottom: 1px solid var(--surface-3);
  }

  .sponsor__benefits li:last-child {
    border-bottom: none;
  }

  .sponsor__benefits svg {
    width: 16px;
    height: 16px;
    color: var(--orange);
    flex-shrink: 0;
  }

  .sponsor__card .btn {
    width: 100%;
  }
</style>
