---
const events=[
  { day:'TBA', month:'', title:'Inaugural Awareness Walk', location:'Location & date to be confirmed', desc:'Our very first walk — uniting the community around mental health.' },
  { day:'TBA', month:'', title:'Youth Mental Health Workshop', location:'Location & date to be confirmed', desc:'Hands-on coping skills for teens and young adults.' },
  { day:'TBA', month:'', title:'Founders Gathering', location:'Location & date to be confirmed', desc:'An evening of connection and hope to launch our first programs.' }
];
---
<section id="events" class="section">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="section-eyebrow reveal">Coming up in year one</span>
      <h2 class="section-title reveal">Our first <em>events</em></h2>
      <p class="section-sub reveal">We're just starting to meet in person. These are the first gatherings of many — come as you are.</p>
    </div>

    <div class="events__grid">
      {events.map((e,i)=>(
        <article class={`events__card reveal reveal-d${(i%3)+1}`}>
          <div class="events__date">
            <span class="events__day">{e.day}</span>
            <span class="events__month">{e.month}</span>
          </div>
          <div class="events__body">
            <h3 class="events__title">{e.title}</h3>
            <p class="events__loc">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              {e.location}
            </p>
            <p class="events__desc">{e.desc}</p>
            <a href="#contact" class="events__link">
              Register <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .events__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;}
  .events__card{display:flex;overflow:hidden;border:1px solid var(--outline-variant);border-radius:var(--radius-sm);background:var(--surface);box-shadow:var(--e1);transition:box-shadow .25s var(--ease-out),transform .25s var(--ease-out);}
  .events__card:hover{box-shadow:var(--e2);transform:translateY(-3px);}
  .events__date{min-width:86px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:var(--primary-container);color:var(--primary);text-align:center;padding:1.1rem .5rem;}
  .events__day{font-size:2rem;line-height:1;font-weight:700;}
  .events__month{font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;margin-top:.25rem;font-weight:600;}
  .events__body{padding:1.5rem;flex:1;display:flex;flex-direction:column;}
  .events__title{font-size:1.15rem;line-height:1.3;margin-bottom:.5rem;}
  .events__loc{display:flex;align-items:center;gap:.4rem;color:var(--primary);font-size:.82rem;margin-bottom:.6rem;font-weight:500;}
  .events__loc svg{width:14px;height:14px;}
  .events__desc{color:var(--muted);font-size:.88rem;line-height:1.6;margin-bottom:1rem;flex:1;}
  .events__link{display:inline-flex;align-items:center;gap:.4rem;color:var(--primary);font-weight:600;font-size:.9rem;}

  @media(max-width:900px){.events__grid{grid-template-columns:1fr;}}
</style>