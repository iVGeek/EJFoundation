---
const tiers=[
  { amount:25, impact:'Funds a workshop' },
  { amount:50, impact:'Materials for a visit' },
  { amount:100, impact:'Keeps helpline running' },
  { amount:250, impact:'A week of talks' }
];
---
<section id="donate" class="section">
  <div class="container">
    <div class="donate-card">
      <div class="donate-card__grid">
        <!-- Copy -->
        <div class="donate__copy reveal">
          <div class="donate__kicker">Support the mission</div>
          <h2 class="donate__title">Your kindness <em>becomes hope</em></h2>
          <p class="donate__text">Every contribution — big or small — goes directly into programs that lift people out of isolation and into support. When you give, someone finds the courage to reach out.</p>

          <div class="donate__campaign">
            <div class="donate__campaign-top">
              <span class="donate__campaign-label">Current campaign</span>
              <span class="donate__campaign-pct">65%</span>
            </div>
            <div class="donate__campaign-title">New Community Center</div>
            <div class="donate__bar"><div class="donate__fill" data-progress="65"></div></div>
            <div class="donate__campaign-nums">
              <span class="donate__raised">$65,000</span>
              <span class="donate__goal">of $100,000 goal</span>
            </div>
          </div>
        </div>

        <!-- Form -->
        <div class="donate__panel reveal reveal-d2">
          <div class="donate__panel-title">Make a difference today</div>
          <div class="donate__panel-sub">One-time or monthly — your choice.</div>

          <div class="donate__tiers">
            {tiers.map(t=>(
              <label class="donate__tier">
                <input type="radio" name="amount" value={t.amount} class="sr-only">
                <span class="donate__tier-amt">${t.amount}</span>
                <span class="donate__tier-impact">{t.impact}</span>
              </label>
            ))}
          </div>

          <div class="donate__custom-row">
            <span class="donate__custom-prefix">$</span>
            <input type="number" class="donate__custom" id="custom-amount" placeholder="Custom amount" min="1">
          </div>

          <div class="donate__freq">
            <button class="donate__freq-btn is-active" data-freq="once">Give once</button>
            <button class="donate__freq-btn" data-freq="monthly">Monthly</button>
          </div>

          <button class="btn btn--light donate__cta" id="donate-cta">
            Donate Now
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          </button>

          <div class="donate__trust">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            100% goes to programs · Secure & confidential
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .donate-card{
    position:relative;
    background:var(--grad-deep);
    border-radius:var(--radius-xl);
    padding:clamp(2.5rem,6vw,4rem);
    color:var(--on-dark);
    overflow:hidden;
    box-shadow:var(--card-shadow-lg);
  }
  .donate-card::after{
    content:'';position:absolute;right:-80px;top:-80px;width:320px;height:320px;
    background:radial-gradient(circle,rgba(201,106,60,.4),transparent 70%);border-radius:50%;
  }
  .donate-card__grid{position:relative;z-index:2;display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,4vw,3rem);align-items:center;}

  .donate__kicker{
    font-size:.72rem;font-weight:800;letter-spacing:.22em;text-transform:uppercase;
    color:#f0b48a;margin-bottom:1rem;
  }
  .donate__title{font-size:clamp(2.2rem,4.5vw,3rem);line-height:1.05;color:var(--on-dark);margin-bottom:1.2rem;}
  .donate__title em{font-style:italic;color:#f0b48a;}
  .donate__text{color:rgba(250,244,234,.82);line-height:1.8;max-width:440px;margin-bottom:2rem;}

  .donate__campaign{background:rgba(250,244,234,.06);border:1px solid rgba(250,244,234,.12);border-radius:var(--radius-md);padding:1.6rem;}
  .donate__campaign-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:.4rem;}
  .donate__campaign-label{font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#f0b48a;}
  .donate__campaign-pct{font-family:var(--font-display);font-size:1.3rem;color:#f0b48a;}
  .donate__campaign-title{font-size:1.2rem;color:var(--on-dark);margin-bottom:1rem;}
  .donate__bar{height:13px;background:rgba(250,244,234,.15);border-radius:var(--radius-full);overflow:hidden;margin-bottom:.8rem;}
  .donate__fill{height:100%;width:0;background:linear-gradient(90deg,#f0b48a,#c96a3c);border-radius:var(--radius-full);transition:width 1.6s var(--ease-out);}
  .donate__campaign-nums{display:flex;align-items:baseline;gap:.6rem;}
  .donate__raised{font-family:var(--font-display);font-size:1.6rem;color:#f0b48a;}
  .donate__goal{font-size:.85rem;color:rgba(250,244,234,.7);}

  .donate__panel-title{font-size:1.5rem;color:var(--on-dark);margin-bottom:.3rem;}
  .donate__panel-sub{color:rgba(250,244,234,.7);font-size:.9rem;margin-bottom:1.5rem;}

  .donate__tiers{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-bottom:1.1rem;}
  .donate__tier{
    padding:1rem;border-radius:var(--radius-md);
    background:rgba(250,244,234,.07);border:1.5px solid rgba(250,244,234,.14);
    cursor:pointer;transition:all .3s var(--ease-out);display:flex;flex-direction:column;gap:.15rem;
  }
  .donate__tier:hover{border-color:#f0b48a;}
  .donate__tier:has(input:checked){border-color:#f0b48a;background:rgba(240,180,138,.14);}
  .donate__tier-amt{font-family:var(--font-display);font-size:1.5rem;color:#f0b48a;}
  .donate__tier-impact{font-size:.78rem;color:rgba(250,244,234,.7);}

  .donate__custom-row{display:flex;align-items:center;gap:.3rem;background:rgba(250,244,234,.07);border:1.5px solid rgba(250,244,234,.14);border-radius:var(--radius-md);padding:0 .8rem;margin-bottom:1.1rem;}
  .donate__custom-prefix{font-weight:800;color:#f0b48a;}
  .donate__custom{width:100%;background:transparent;border:none;padding:.9rem;color:var(--on-dark);font-size:1.05rem;font-family:var(--font-body);}
  .donate__custom:focus{outline:none;}

  .donate__freq{display:flex;gap:.5rem;margin-bottom:1.1rem;}
  .donate__freq-btn{flex:1;padding:.7rem;border-radius:var(--radius-md);border:1.5px solid rgba(250,244,234,.18);color:rgba(250,244,234,.8);font-weight:700;font-size:.9rem;transition:all .25s var(--ease-out);}
  .donate__freq-btn.is-active{background:var(--terra);color:#fff;border-color:transparent;}

  .donate__cta{width:100%;justify-content:center;font-size:1.02rem;padding:1rem;}
  .donate__trust{display:flex;align-items:center;justify-content:center;gap:.5rem;color:rgba(250,244,234,.7);font-size:.82rem;margin-top:1.2rem;}
  .donate__trust svg{width:16px;height:16px;color:#f0b48a;}

  @media(max-width:900px){.donate-card__grid{grid-template-columns:1fr;}}
</style>

<script>
  const freqBtns=document.querySelectorAll('.donate__freq-btn');
  freqBtns.forEach(b=>b.addEventListener('click',()=>{freqBtns.forEach(x=>x.classList.remove('is-active'));b.classList.add('is-active');}));

  const fill=document.querySelector('.donate__fill');
  if(fill){
    const obs=new IntersectionObserver(e=>{e.forEach(en=>{if(en.isIntersecting){fill.style.width=fill.dataset.progress+'%';obs.unobserve(en.target);}});},{threshold:.4});
    obs.observe(fill);
  }
</script>
