---
const PRICES = { USD:[25,50,100,250], KES:[500,1000,2500,5000], NGN:[1000,2500,5000,10000], GHS:[50,100,250,500], ZAR:[100,250,500,1000] };
const SYMBOLS = { USD:'$', KES:'KSh', NGN:'₦', GHS:'GH₵', ZAR:'R' };
const impacts = ['Buys helpline flyers','Funds a peer-support session','Keeps helpline online for a day','Covers our first workshop'];
const defaultCurrency = import.meta.env.PUBLIC_PAYSTACK_DEFAULT_CURRENCY || 'KES';
const money=(c,n)=>{const s=SYMBOLS[c]||c;return (c==='KES'?`${s} ${n.toLocaleString()}`:`${s}${n.toLocaleString()}`);};
---
<section id="donate" class="section">
  <div class="container">
    <div class="donate-card">
      <div class="donate-card__grid">
        <!-- Copy -->
        <div class="donate__copy reveal">
          <div class="donate__kicker">Founding campaign</div>
          <h2 class="donate__title">Help us launch <em>year one</em></h2>
          <p class="donate__text">We're brand new — every donation is a founding gift that goes straight into building our first programs and getting the helpline running. When you give, a brand-new foundation takes its next step.</p>

          <div class="donate__campaign">
            <div class="donate__campaign-top">
              <span class="donate__campaign-label">Year-one goal</span>
              <span class="donate__campaign-pct" id="donate-pct">Loading…</span>
            </div>
            <div class="donate__campaign-title">Launch the 24/7 Helpline</div>
            <div class="donate__bar"><div class="donate__fill" id="donate-fill" style="width:0%"></div></div>
            <div class="donate__campaign-nums">
              <span class="donate__raised" id="donate-raised">KSh 0</span>
              <span class="donate__goal">of KSh 1,000,000 goal</span>
            </div>
          </div>
        </div>

        <!-- Form -->
        <div class="donate__panel reveal reveal-d2">
          <div class="donate__panel-title">Make a founding gift</div>
          <div class="donate__panel-sub">One-time or monthly — every gift counts at the start.</div>

          <div class="donate__field">
            <label for="donate-email" class="donate__label">Email for your receipt</label>
            <input type="email" id="donate-email" placeholder="you@example.com" required class="donate__input">
          </div>

          <div class="donate__tiers">
            {impacts.map((im,i)=>(
              <label class="donate__tier">
                <input type="radio" name="amount" value={PRICES[defaultCurrency][i]} data-idx={i} class="sr-only" checked={i===0}>
                <span class="donate__tier-amt" data-amt={i}>{money(defaultCurrency,PRICES[defaultCurrency][i])}</span>
                <span class="donate__tier-impact">{im}</span>
              </label>
            ))}
          </div>

          <div class="donate__custom-row">
            <span class="donate__custom-prefix">{SYMBOLS[defaultCurrency]||defaultCurrency}</span>
            <input type="number" class="donate__custom" id="custom-amount" placeholder="Custom amount" min="1">
          </div>

          <div class="donate__freq">
            <button class="donate__freq-btn is-active" data-freq="once" type="button">Give once</button>
            <button class="donate__freq-btn" data-freq="monthly" type="button">Monthly</button>
          </div>

          <button class="btn btn--primary donate__cta" id="donate-cta" type="button">
            Donate
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .donate-card{
    position:relative;
    background:var(--surface);
    border:1px solid var(--outline-variant);
    border-radius:var(--radius-lg);
    padding:clamp(2.5rem,6vw,3.8rem);
    box-shadow:var(--e2);
  }
  .donate-card__grid{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,4vw,3rem);align-items:center;}

  .donate__kicker{
    font-size:.78rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;
    color:var(--primary);margin-bottom:.9rem;
  }
  .donate__title{font-size:clamp(1.9rem,4.5vw,2.6rem);line-height:1.14;margin-bottom:1.1rem;}
  .donate__title em{font-style:italic;color:var(--primary);}
  .donate__text{color:var(--on-surface-variant);line-height:1.75;max-width:440px;margin-bottom:1.8rem;}

  .donate__campaign{background:var(--surface-variant);border:1px solid var(--outline-variant);border-radius:var(--radius-sm);padding:1.5rem;}
  .donate__campaign-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:.35rem;}
  .donate__campaign-label{font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);}
  .donate__campaign-pct{font-size:1.35rem;font-weight:600;color:var(--primary);}
  .donate__campaign-title{font-size:1.15rem;font-weight:600;margin-bottom:.9rem;}
  .donate__campaign-note{font-size:.78rem;color:var(--muted);margin-top:.9rem;line-height:1.55;}
  .donate__bar{height:8px;background:var(--surface-container);border-radius:var(--radius-full);overflow:hidden;margin-bottom:.8rem;}
  .donate__fill{height:100%;width:0;background:var(--primary);border-radius:var(--radius-full);transition:width 1.4s var(--ease-out);position:relative;}
  .donate__fill::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.35),transparent);animation:donate-shimmer 2.4s infinite;}
  @keyframes donate-shimmer{0%{transform:translateX(-100%);}100%{transform:translateX(100%);}}
  .donate__campaign-nums{display:flex;align-items:baseline;gap:.6rem;flex-wrap:wrap;}
  .donate__raised{font-size:1.6rem;font-weight:700;color:var(--primary);letter-spacing:-.01em;}
  .donate__goal{font-size:.88rem;color:var(--muted);}

  .donate__panel-title{font-size:1.4rem;font-weight:600;margin-bottom:.25rem;}
  .donate__panel-sub{color:var(--muted);font-size:.92rem;margin-bottom:1.3rem;}

  .donate__field{margin-bottom:1rem;}
  .donate__label{display:block;font-size:.78rem;font-weight:500;color:var(--on-surface-variant);margin-bottom:.4rem;}
  .donate__input{
    width:100%;background:var(--surface);border:1.5px solid var(--outline);
    border-radius:var(--radius-xs);padding:.85rem 1rem;color:var(--on-surface);
    font-size:1rem;font-family:var(--font-body);transition:border-color .2s;
  }
  .donate__input:focus{outline:none;border-color:var(--primary);}
  .donate__input::placeholder{color:var(--muted);}

  .donate__tiers{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:1rem;}
  .donate__tier{
    padding:.95rem 1rem;border-radius:var(--radius-sm);
    background:var(--surface);border:1.5px solid var(--outline);
    cursor:pointer;transition:all .2s var(--ease-out);display:flex;flex-direction:column;gap:.12rem;
  }
  .donate__tier:hover{border-color:var(--primary);}
  .donate__tier:has(input:checked){border-color:var(--primary);background:var(--primary-container);}
  .donate__tier-amt{font-size:1.45rem;font-weight:700;color:var(--primary);letter-spacing:-.01em;}
  .donate__tier:not(:has(input:checked)) .donate__tier-amt{color:var(--on-surface);}
  .donate__tier:has(input:checked) .donate__tier-amt{color:var(--primary);}
  .donate__tier-impact{font-size:.8rem;color:var(--muted);}

  .donate__custom-row{display:flex;align-items:center;gap:.4rem;background:var(--surface);border:1.5px solid var(--outline);border-radius:var(--radius-xs);padding:0 .9rem;margin-bottom:1rem;transition:border-color .2s;}
  .donate__custom-row:focus-within{border-color:var(--primary);}
  .donate__custom-prefix{font-weight:600;color:var(--muted);}
  .donate__custom{width:100%;background:transparent;border:none;padding:.85rem;color:var(--on-surface);font-size:1rem;font-family:var(--font-body);}
  .donate__custom:focus{outline:none;}

  .donate__freq{display:flex;gap:.5rem;margin-bottom:1.1rem;background:var(--surface-variant);border-radius:var(--radius-xs);padding:.35rem;}
  .donate__freq-btn{
    flex:1;padding:.6rem;border-radius:var(--radius-xs);border:none;
    color:var(--on-surface-variant);font-weight:500;font-size:.9rem;
    transition:all .2s var(--ease-out);background:transparent;
  }
  .donate__freq-btn.is-active{background:var(--surface);color:var(--primary);box-shadow:var(--e1);font-weight:600;}

  .donate__cta{width:100%;justify-content:center;font-size:1rem;height:50px;}

  @media(max-width:900px){.donate-card__grid{grid-template-columns:1fr;}}
</style>

<script>
  const key=import.meta.env.PUBLIC_PAYSTACK_KEY;
  const CURRENCIES=['NGN','GHS','KES','ZAR','USD'];
  const SYMBOLS={USD:'$',KES:'KSh',NGN:'₦',GHS:'GH₵',ZAR:'R'};
  const PRICES={USD:[25,50,100,250],KES:[500,1000,2500,5000],NGN:[1000,2500,5000,10000],GHS:[50,100,250,500],ZAR:[100,250,500,1000]};
  const COUNTRY_MAP={NG:'NGN',GH:'GHS',KE:'KES',ZA:'ZAR'};
  const DEFAULT=import.meta.env.PUBLIC_PAYSTACK_DEFAULT_CURRENCY||'KES';
  let currency=DEFAULT;

  const fmt=(c,n)=>{const s=SYMBOLS[c]||c;const num=n.toLocaleString('en');return c==='KES'?`${s} ${num}`:`${s}${num}`;};

  function applyCurrency(c){
    if(!CURRENCIES.includes(c)) return;
    currency=c;
    document.querySelectorAll('.donate__tier-amt').forEach(el=>{
      const i=parseInt(el.dataset.amt||'0');const v=PRICES[c][i]||PRICES[c][0];
      el.textContent=fmt(c,v);
      const inp=el.closest('.donate__tier').querySelector('input');if(inp)inp.value=v;
    });
    const prefix=document.querySelector('.donate__custom-prefix');
    if(prefix) prefix.textContent=SYMBOLS[c]||c;
  }

  async function detectCurrency(){
    const tries=[
      async()=>{const r=await fetch('https://get.geojs.io/v1/ip/country.json',{signal:AbortSignal.timeout(4000)});const j=await r.json();return j&&j.country;},
      async()=>{const r=await fetch('https://ipapi.co/json/',{signal:AbortSignal.timeout(4000)});const j=await r.json();return j&&j.country_code;}
    ];
    for(const f of tries){
      try{const cc=await f();if(cc&&COUNTRY_MAP[cc]){applyCurrency(COUNTRY_MAP[cc]);return;}}catch(e){}
    }
  }

  function loadPaystack(){
    return new Promise(res=>{
      if(window.PaystackPop) return res();
      const s=document.createElement('script');
      s.src='https://js.paystack.co/v1/inline.js';
      s.onload=()=>res();
      s.onerror=()=>res();
      document.head.appendChild(s);
    });
  }

  detectCurrency();

  const freqBtns=document.querySelectorAll('.donate__freq-btn');
  freqBtns.forEach(b=>b.addEventListener('click',()=>{freqBtns.forEach(x=>x.classList.remove('is-active'));b.classList.add('is-active');}));

  const custom=document.getElementById('custom-amount');
  document.querySelectorAll('.donate__tier input').forEach(r=>r.addEventListener('change',()=>{if(custom)custom.value='';}));
  custom?.addEventListener('input',()=>{document.querySelectorAll('.donate__tier input').forEach(r=>r.checked=false);});

  const CAMPAIGN_GOAL = 1000000; // KES
  const fmtKes = n => 'KSh ' + Math.round(n).toLocaleString('en');
  const fill = document.getElementById('donate-fill');
  const raisedEl = document.getElementById('donate-raised');
  const pctEl = document.getElementById('donate-pct');
  let revealedOnce = false;
  const obs = new IntersectionObserver(finish => {
    finish.forEach(en => {
      if (en.isIntersecting && !revealedOnce) {
        revealedOnce = true;
        observeOrFill();
        obs.disconnect();
      }
    });
  }, { threshold: .4 });

  function setCampaign(kes) {
    const pct = Math.min(100, (kes / CAMPAIGN_GOAL) * 100);
    if (raisedEl) raisedEl.textContent = fmtKes(kes);
    if (pctEl) pctEl.textContent = pct.toFixed(pct % 1 ? 1 : 0) + '%';
    if (fill) fill.style.width = pct + '%';
  }

  async function observeOrFill() {
    try {
      const r = await fetch('/api/raised', { cache: 'no-store' });
      const j = await r.json();
      if (j && j.ok && typeof j.total === 'number') {
        setCampaign(j.total / 100); // Paystack reports smallest unit
      } else {
        setCampaign(0);
      }
    } catch (e) {
      setCampaign(0);
    }
  }

  if (fill) {
    if (fill.dataset.progress) fill.style.width = fill.dataset.progress + '%';
    obs.observe(fill);
  }
  // Warm up fetch in background regardless of scroll
  observeOrFill();

  document.getElementById('donate-cta')?.addEventListener('click',async()=>{
    if(!key || key.indexOf('pk_')!==0 || key.indexOf('0000')>-1){alert('Paystack isn\'t configured yet — add your public key to the .env file, then rebuild.');return;}
    const email=(document.getElementById('donate-email')?.value||'').trim();
    const emailOk=/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    if(!emailOk){alert('Email required — please enter your email to continue.');return;}
    const customV=parseFloat(custom?.value||'');
    let amount=null;
    if(customV>0) amount=Math.round(customV);
    else{
      const checked=document.querySelector('.donate__tier input:checked');
      amount=checked?parseInt(checked.value,10):null;
    }
    if(!amount||amount<=0){alert('Please choose an amount.');return;}
    await loadPaystack();
    if(!window.PaystackPop){alert('Couldn\'t load the Paystack checkout.');return;}
    const handler=PaystackPop.setup({
      key,
      email,
      amount:amount*100,
      currency,
      ref:'EJH'+Date.now()+''+Math.floor(100+Math.random()*900),
      metadata:{custom_fields:[
        {display_name:'Frequency',variable_name:'recurring',value:document.querySelector('.donate__freq-btn.is-active')?.dataset.freq==='monthly'?'Monthly':'Once'},
        {display_name:'Gift amount',variable_name:'gift',value:fmt(currency,amount)}
      ]},
      callback:response=>{
        alert('Thank you! Your founding gift of '+fmt(currency,amount)+' was received. Reference: '+response.reference);
      },
      onClose:()=>{}
    });
    handler.openIframe();
  });
</script>