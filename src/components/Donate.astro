---
const amounts = [10, 25, 50, 100];
---
<section id="donate" class="section" aria-labelledby="donate-heading">
  <div class="container">
    <div class="section__header">
      <h2 id="donate-heading" class="section__title reveal">Support Our Mission</h2>
      <p class="section__subtitle reveal reveal-delay-1">Your contribution helps us reach more people and create lasting impact in mental health awareness.</p>
    </div>

    <div class="donate__grid">
      <div class="donate__card card reveal reveal-delay-1">
        <h3 class="donate__card-title">Monthly Support</h3>
        <p class="donate__card-text">Become a sustaining supporter with recurring monthly donations.</p>
        <div class="donate__amounts">
          {amounts.map(a => (
            <button class="donate__amount" data-amount={a}>${a}</button>
          ))}
        </div>
        <input type="number" class="donate__custom" placeholder="Custom amount" min="1">
        <button class="btn btn--primary donate__btn">Donate Monthly</button>
      </div>

      <div class="donate__card card reveal reveal-delay-2">
        <h3 class="donate__card-title">One-Time Donation</h3>
        <p class="donate__card-text">Make an immediate impact with a single contribution of any size.</p>
        <div class="donate__amounts">
          {amounts.map(a => (
            <button class="donate__amount" data-amount={a}>${a}</button>
          ))}
        </div>
        <input type="number" class="donate__custom" placeholder="Custom amount" min="1">
        <button class="btn btn--secondary donate__btn">Give Once</button>
      </div>
    </div>

    <div class="donate__progress card reveal reveal-delay-3">
      <h3 class="donate__progress-title">Current Campaign: New Community Center</h3>
      <div class="donate__bar">
        <div class="donate__fill" data-progress="65"></div>
      </div>
      <div class="donate__progress-text">
        <span class="donate__raised">$65,000</span> raised of <span class="donate__goal">$100,000</span> goal
      </div>
    </div>
  </div>
</section>

<style>
  .donate__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .donate__card {
    text-align: center;
    padding: var(--space-xl);
  }

  .donate__card-title {
    font-size: 1.5rem;
    color: var(--orange);
    margin-bottom: var(--space-sm);
  }

  .donate__card-text {
    color: var(--text-2);
    margin-bottom: var(--space-lg);
    font-size: 0.95rem;
  }

  .donate__amounts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .donate__amount {
    padding: 0.875rem;
    border: 2px solid var(--surface-4);
    background: transparent;
    color: var(--text-1);
    border-radius: var(--radius-md);
    font-size: 1.1rem;
    font-weight: 600;
    transition: all var(--duration-fast);
  }

  .donate__amount:hover,
  .donate__amount.active {
    border-color: var(--orange);
    background: var(--orange);
    color: #fff;
  }

  .donate__custom {
    width: 100%;
    padding: 0.875rem;
    background: var(--surface-3);
    border: 2px solid var(--surface-4);
    border-radius: var(--radius-md);
    color: var(--text-1);
    font-size: 1rem;
    margin-bottom: var(--space-md);
    transition: border-color var(--duration-fast);
    font-family: var(--font-body);
  }

  .donate__custom:focus {
    outline: none;
    border-color: var(--orange);
  }

  .donate__btn {
    width: 100%;
  }

  .donate__progress {
    text-align: center;
    padding: var(--space-xl);
  }

  .donate__progress-title {
    font-size: 1.3rem;
    margin-bottom: var(--space-lg);
    color: var(--text-1);
  }

  .donate__bar {
    width: 100%;
    height: 16px;
    background: var(--surface-3);
    border-radius: var(--radius-full);
    overflow: hidden;
    margin-bottom: var(--space-md);
  }

  .donate__fill {
    height: 100%;
    width: 0;
    background: var(--gradient-brand);
    border-radius: var(--radius-full);
    transition: width 1.5s var(--ease-out);
    position: relative;
  }

  .donate__fill::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
    animation: shimmer 2s infinite;
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  .donate__progress-text {
    font-size: 0.95rem;
    color: var(--text-2);
  }

  .donate__raised, .donate__goal {
    font-weight: 700;
    color: var(--orange);
  }
</style>

<script>
  document.querySelectorAll('.donate__amount').forEach(btn => {
    btn.addEventListener('click', () => {
      const parent = btn.closest('.donate__card')!;
      parent.querySelectorAll('.donate__amount').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });

  // Progress bar animation
  const fill = document.querySelector('.donate__fill') as HTMLElement;
  if (fill) {
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          fill.style.width = fill.dataset.progress + '%';
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.5 });
    obs.observe(fill);
  }
</script>
