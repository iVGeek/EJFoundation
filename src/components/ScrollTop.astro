---
<button id="scroll-top" class="scroll-top" aria-label="Back to top">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
</button>

<style>
  .scroll-top{
    position:fixed;right:22px;bottom:22px;z-index:1040;
    width:52px;height:52px;border-radius:var(--radius-full);
    background:var(--primary);color:var(--on-primary);
    border:none;display:flex;align-items:center;justify-content:center;
    box-shadow:var(--e3);
    opacity:0;visibility:hidden;transform:translateY(12px);
    transition:all .3s var(--ease-out);cursor:pointer;
  }
  .scroll-top.is-visible{opacity:1;visibility:visible;transform:translateY(0);}
  .scroll-top:hover{background:var(--primary-hover);box-shadow:var(--e2);}
  .scroll-top svg{width:24px;height:24px;}
</style>

<script>
  const btn=document.getElementById('scroll-top');
  window.addEventListener('scroll',()=>{
    const visible=window.scrollY>500;
    btn?.classList.toggle('is-visible',visible);
    if(btn) btn.setAttribute('aria-hidden',String(!visible));
  },{passive:true});
  btn?.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));
</script>