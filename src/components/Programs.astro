---
const programs = [
  { title:'Mental Health Marathon', desc:'An annual community event uniting people through movement, education, and shared purpose.', tag:'Flagship' },
  { title:'Children Home Visits', desc:'Mentorship, play, and emotional safety for children in care facilities.', tag:'Youth' },
  { title:'Elderly Home Visits', desc:'Companionship and emotional support for seniors who may feel forgotten.', tag:'Community' },
  { title:'University Talks', desc:'Open, judgment-free mental health conversations with students.', tag:'Education' },
  { title:'Civic Education', desc:'Teaching mental health rights and where to find help in the community.', tag:'Awareness' },
  { title:'24/7 Helpline & Chat', desc:'Round-the-clock confidential support for crisis moments.', tag:'Critical', hot:true }
];
---
<section id="programs" class="section section--alt">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="section-eyebrow reveal">Programs</span>
      <h2 class="section-title reveal">Ways we <em>show up</em> for you</h2>
      <p class="section-sub reveal">Every program meets people where they are — with warmth, without judgment, and always free.</p>
    </div>

    <div class="progs">
      {programs.map((p,i)=>(
        <article class={`prog reveal reveal-d${(i%3)+1}`}>
          <span class="prog__num">{String(i+1).padStart(2,'0')}</span>
          <div class="prog__body">
            <div class="prog__tagrow">
              {p.hot && <span class="prog__hot">● 24/7</span>}
              {!p.hot && <span class="prog__tag">{p.tag}</span>}
            </div>
            <h3 class="prog__title">{p.title}</h3>
            <p class="prog__desc">{p.desc}</p>
          </div>
          <span class="prog__arw" aria-hidden="true">→</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .progs{display:grid;grid-template-columns:1fr;gap:.95rem;max-width:940px;margin:0 auto;}
  .prog{
    display:flex;align-items:center;gap:1.6rem;
    background:var(--card);border:1px solid var(--line);
    border-radius:var(--radius-md);padding:1.6rem 1.8rem;
    transition:transform .25s var(--ease-out),border-color .25s,box-shadow .25s;
  }
  .prog:hover{border-color:var(--terra);transform:translateX(10px);box-shadow:var(--card-shadow);}
  .prog:hover .prog__num{color:var(--terra-deep);}

  .prog__num{
    font-family:var(--font-display);font-size:2.4rem;color:var(--terra);
    width:64px;flex-shrink:0;text-align:center;transition:color .3s;
  }
  .prog__body{flex:1;}
  .prog__tagrow{margin-bottom:.25rem;}
  .prog__tag{
    font-size:.66rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;
    color:var(--terra);background:rgba(201,106,60,.1);border:1px solid var(--line);
    padding:.25rem .6rem;border-radius:var(--radius-full);
  }
  .prog__hot{
    font-size:.66rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;
    color:#fff;background:var(--grad-brand);padding:.28rem .6rem;border-radius:var(--radius-full);
    box-shadow:var(--glow-soft);
  }
  .prog__title{font-size:1.45rem;line-height:1.2;letter-spacing:-.01em;}
  .prog__desc{color:var(--muted);font-size:.95rem;line-height:1.6;margin-top:.2rem;}
  .prog__arw{color:var(--terra);font-size:1.5rem;opacity:0;transform:translateX(-8px);transition:all .3s var(--ease-out);}
  .prog:hover .prog__arw{opacity:1;transform:translateX(0);}

  @media(max-width:560px){
    .prog{padding:1.3rem;gap:1rem;}
    .prog__num{font-size:1.8rem;width:44px;}
  }
</style>
