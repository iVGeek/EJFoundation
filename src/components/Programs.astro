---
const programs = [
  { title:'Mental Health Marathon', desc:'Our flagship year-one program — uniting people through movement, education, and shared purpose.', tag:'Flagship' },
  { title:'Children Home Visits', desc:'Mentorship, play, and emotional safety for children in care facilities, starting in our first year.', tag:'Youth' },
  { title:'Elderly Home Visits', desc:'Companionship and emotional support for seniors who may feel forgotten.', tag:'Community' },
  { title:'University Talks', desc:'Open, judgment-free mental health conversations with students.', tag:'Education' },
  { title:'Civic Education', desc:'Teaching mental health rights and where to find help in the community.', tag:'Awareness' },
  { title:'24/7 Helpline & Chat', desc:'Round-the-clock confidential support for crisis moments. Our biggest year-one goal — your gift gets it running.', tag:'Critical', hot:true }
];
---
<section id="programs" class="section section--alt">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="section-eyebrow reveal">Programs</span>
      <h2 class="section-title reveal">Ways we <em>show up</em> for you</h2>
      <p class="section-sub reveal">Every program is brand new — built together, one at a time, in our first year. Your help decides what we can start next.</p>
    </div>

    <div class="progs">
      {programs.map((p,i)=>(
        <article class={`prog reveal reveal-d${(i%3)+1}`}>
          <span class="prog__num">{String(i+1).padStart(2,'0')}</span>
          <div class="prog__body">
            <div class="prog__tagrow">
              {p.hot && <span class="prog__hot">● 24/7</span>}
              {!p.hot && <span class="prog__tag">{p.tag}</span>}
            </div>
            <h3 class="prog__title">{p.title}</h3>
            <p class="prog__desc">{p.desc}</p>
          </div>
          <span class="prog__arw" aria-hidden="true">→</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .progs{display:grid;grid-template-columns:1fr;gap:.9rem;max-width:940px;margin:0 auto;}
  .prog{
    display:flex;align-items:center;gap:1.4rem;
    background:var(--surface);border:1px solid var(--outline-variant);
    border-radius:var(--radius-sm);padding:1.4rem 1.6rem;
    box-shadow:var(--e1);
    transition:box-shadow .25s var(--ease-out),transform .25s var(--ease-out),border-color .25s;
  }
  .prog:hover{box-shadow:var(--e2);border-color:var(--outline);transform:translateY(-2px);}

  .prog__num{
    font-size:.95rem;font-weight:600;color:var(--primary);
    width:44px;flex-shrink:0;text-align:center;
    background:var(--primary-container);border-radius:var(--radius-xs);padding:.5rem .2rem;
  }
  .prog__body{flex:1;}
  .prog__tagrow{margin-bottom:.3rem;}
  .prog__tag{
    font-size:.68rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;
    color:var(--primary);
    background:var(--primary-container);
    padding:.22rem .6rem;border-radius:var(--radius-xs);
  }
  .prog__hot{
    font-size:.68rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;
    color:var(--on-primary);background:var(--primary);
    padding:.24rem .6rem;border-radius:var(--radius-xs);
  }
  .prog__title{font-size:1.2rem;line-height:1.3;font-weight:600;}
  .prog__desc{color:var(--muted);font-size:.93rem;line-height:1.6;margin-top:.15rem;}
  .prog__arw{color:var(--primary);font-size:1.2rem;opacity:0;transform:translateX(-8px);transition:all .25s var(--ease-out);}
  .prog:hover .prog__arw{opacity:1;transform:translateX(0);}

  @media(max-width:560px){
    .prog{padding:1.2rem;gap:.9rem;}
    .prog__num{width:36px;font-size:.8rem;}
  }
</style>